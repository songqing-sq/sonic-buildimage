[Unit]
Description=DASH HA container
Requires=database.service config-setup.service swss.service
After=database.service swss.service interfaces-config.service
BindsTo=sonic.target
After=sonic.target
Before=ntp-config.service
StartLimitIntervalSec=1200
StartLimitBurst=3

[Service]
User=admin
ExecCondition=/bin/bash /usr/local/bin/is-npu-or-dpu.sh -n
ExecStartPre=/usr/local/bin/dash-ha.sh start
ExecStart=/usr/local/bin/dash-ha.sh wait
ExecStop=/usr/local/bin/dash-ha.sh stop
RestartSec=30

[Install]
WantedBy=sonic.target
