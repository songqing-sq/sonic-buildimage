# -----------------------------------------------------------------------------
# default_users.json: root-only in fsroot-vs (0600 root:shadow), so it is
# rendered here rather than snapshotted. Legacy fills username=admin,
# password=<admin /etc/shadow hash>, expire=CHANGE_DEFAULT_PASSWORD. The hash
# is a build-time secret shipped empty (booted config-setup sets the real
# credential); 0600 gid=42 (shadow) matches Make.
# -----------------------------------------------------------------------------
genrule(
    name = "default_users_json",
    srcs = ["//files/build_templates:default_users.json.j2"],
    outs = ["default_users.json"],
    cmd = ("$(execpath @sonic_build_infra//jinja2:render) " +
           "$(execpath //files/build_templates:default_users.json.j2) $@ " +
           "username=admin password= password_expire=false"),
    tools = ["@sonic_build_infra//jinja2:render"],
)

tar(
    name = "version_layer",
    srcs = [":default_users_json"],
    mtree = [
        "./etc/sonic/default_users.json uid=0 gid=42 mode=0600 type=file content=$(location :default_users_json)",
    ],
    visibility = ["//platform:__subpackages__"],
)

# -----------------------------------------------------------------------------
# Empty mount-point / SONiC-runtime directories that debootstrap + build_debian
# create but no package owns (flatten drops empty dirs otherwise). Modes from
# fsroot-vs (all 0755). host/ is the SONiC persistent partition mountpoint,
# sonic/ the legacy mountpoint; media/mnt/opt/srv are FHS mount points.
# -----------------------------------------------------------------------------
tar(
    name = "dirs_layer",
    mtree = [
        "./media uid=0 gid=0 mode=0755 type=dir",
        "./mnt uid=0 gid=0 mode=0755 type=dir",
        "./opt uid=0 gid=0 mode=0755 type=dir",
        "./srv uid=0 gid=0 mode=0755 type=dir",
        "./host uid=0 gid=0 mode=0755 type=dir",
        "./sonic uid=0 gid=0 mode=0755 type=dir",
        "./var/log uid=0 gid=0 mode=0755 type=dir",
    ],
    visibility = ["//platform:__subpackages__"],
)

# -----------------------------------------------------------------------------
# The static /dev entries debootstrap creates in the rootfs before devtmpfs is
# mounted over it. Only the dirs and symlinks live here: the char device nodes
# (console, null, ...) need mknod, which the unprivileged build sandbox denies,
# so they are synthesized by the mksquashfs pseudo definitions in
# sonic_onie_image instead. Contents and modes mirror fsroot-vs/dev.
# -----------------------------------------------------------------------------
tar(
    name = "dev_layer",
    mtree = [
        "./dev uid=0 gid=0 mode=0755 type=dir",
        "./dev/pts uid=0 gid=0 mode=0755 type=dir",
        "./dev/shm uid=0 gid=0 mode=0755 type=dir",
        "./dev/fd uid=0 gid=0 type=link link=/proc/self/fd",
        "./dev/stdin uid=0 gid=0 type=link link=/proc/self/fd/0",
        "./dev/stdout uid=0 gid=0 type=link link=/proc/self/fd/1",
        "./dev/stderr uid=0 gid=0 type=link link=/proc/self/fd/2",
    ],
    visibility = ["//platform:__subpackages__"],
)

# -----------------------------------------------------------------------------
# The admin user's home directory. build_debian.sh:294 runs
#   chroot useradd -G sudo,docker admin -c ... -m -s /bin/bash
# whose `-m` creates /home/admin (admin:admin 0700) and copies /etc/skel into
# it. Nothing in the Bazel build runs useradd — /etc/passwd is shipped as a
# snapshot — so without this layer /home/admin does not exist and every admin
# login prints "change directory failed: No such file or directory" and falls
# back to /, losing the shell dotfiles. The skel sources are taken from the bash
# deb, which owns /etc/skel, rather than snapshotted.
# -----------------------------------------------------------------------------
genrule(
    name = "home_layer",
    srcs = ["@trixie//bash:data"],
    outs = ["home_layer.tar"],
    cmd = ("set -euo pipefail; " +
           "OUTTAR=$$(realpath $(RULEDIR))/$$(basename $@); " +
           "W=$$(realpath $(RULEDIR))/_home; rm -rf $$W; " +
           "mkdir -p $$W/home/admin; " +
           "chmod 0755 $$W $$W/home; chmod 0700 $$W/home/admin; " +
           "tar -xzf $(location @trixie//bash:data) -C $$W/home/admin " +
           "  --strip-components=3 ./etc/skel/.bash_logout ./etc/skel/.bashrc " +
           "  ./etc/skel/.profile; " +
           "cd $$W; " +
           "tar -cf $$OUTTAR --owner=0 --group=0 --numeric-owner --sort=name .; " +
           "rm -rf $$W"),
    visibility = ["//platform:__subpackages__"],
)

# -----------------------------------------------------------------------------
# SONiC host Python wheels: the wheels build_debian.sh / sonic_debian_extension
# pip-install into the host rootfs (sonic-utilities CLI under /usr/local/bin +
# their packages under /usr/local/lib/python3/dist-packages). Each wheel repo
# exposes an :install tar (py_wheel/tar convention). Third-party pip deps that
# are NOT apt python3-* packages are added via host_pip_layer.
# -----------------------------------------------------------------------------
flatten(
    name = "sonic_wheels_layer",
    deduplicate = True,
    tars = [
        ":host_pip_layer",
        "@sonic-py-common//:install",
        "@sonic-config-engine//:install",
        "@sonic-platform-common//:install",
        "@sonic-yang-models//:install",
        "@sonic-yang-mgmt//:install",
        "@sonic-host-services//:install",
        "@sonic-utilities//:install",
        # healthd — system-health.service's ExecStart.
        "@system-health//:install",
        # ctrmgrd.py / container / kube_commands.py / docker-wait-any: the kube
        # container management scripts every ctl script calls in kube mode.
        "//src/sonic-ctrmgrd/ctrmgr:install",
        # redisdl + the redis-dump / redis-load entry points.
        "@redis-dump-load-py3//:install",
        # sonic_platform_pddf_base: the PDDF platform API base classes vendor
        # sonic_platform packages subclass.
        "@sonic-platform-pddf-common//:install",
    ],
    visibility = ["//platform:__subpackages__"],
)

# Third-party PyPI runtime deps of the SONiC host wheels that resolve in the
# @pip_util2 uv hub. Deps the hub lacks (redis/bitarray/docker/filelock/
# pexpect/jsonpatch/click_log/lazy_object_proxy/www_authenticate/
# semantic_version/prettyprinter/docker_image_py) are a known gap — they are
# sonic-utilities CLI runtime deps, not boot-critical; Make pip-installs them
# from PyPI. Apt-provided python3-* deps (netifaces/pyroute2/dbus/gi/lxml/...)
# ship via base_layer.
site_packages(
    name = "host_pip_layer",
    srcs = [
        "@pip_util2//natsort",
        "@pip_util2//pyyaml",
        "@pip_util2//lxml",
        "@pip_util2//netaddr",
        "@pip_util2//jinja2",
        "@pip_util2//ijson",
        "@pip_util2//jsonpointer",
        "@pip_util2//jsondiff",
        "@pip_util2//tabulate",
        "@pip_util2//psutil",
        "@pip_util2//click",
        "@pip_util2//toposort",
        "@pip_util2//requests",
        # These three carry console_scripts that Make's image has under
        # /usr/local/bin: pyang -> pyang/yang2dsdl/yang2html, jsonschema ->
        # jsonschema, pyroute2 -> pyroute2-{decoder,dhcp-client,test-platform}
        # and ss2. They resolve in the hub, so there is no reason to be missing.
        "@pip_util2//pyang",
        "@pip_util2//jsonschema",
        "@pip_util2//pyroute2",
        # sonic-utilities setup.py install_requires — the CLI imports these at
