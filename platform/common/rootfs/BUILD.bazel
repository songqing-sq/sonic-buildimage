           "    echo \"<delegatePublic publicIdStartString=\\\"-//GlobalTransCorp//DTD XML Catalogs V1.0-Based Extension V1.0//EN\\\" catalog=\\\"$$c\\\"/>\"; " +
           "    echo '</catalog>'; } > $$D/$$o; " +
           "done"),
