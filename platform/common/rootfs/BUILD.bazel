# -----------------------------------------------------------------------------
# default_users.json: root-only in fsroot-vs (0600 root:shadow), so it is
# rendered here rather than snapshotted. Legacy fills username=admin,
# password=<admin /etc/shadow hash>, expire=CHANGE_DEFAULT_PASSWORD. The hash
# is a build-time secret shipped empty (booted config-setup sets the real
# credential); 0600 gid=42 (shadow) matches Make.
# -----------------------------------------------------------------------------
genrule(
    name = "default_users_json",
    srcs = ["//files/build_templates:default_users.json.j2"],
    outs = ["default_users.json"],
    cmd = ("$(execpath @sonic_build_infra//jinja2:render) " +
           "$(execpath //files/build_templates:default_users.json.j2) $@ " +
           "username=admin password= password_expire=false"),
    tools = ["@sonic_build_infra//jinja2:render"],
)

tar(
    name = "version_layer",
    srcs = [":default_users_json"],
    mtree = [
        "./etc/sonic/default_users.json uid=0 gid=42 mode=0600 type=file content=$(location :default_users_json)",
    ],
    visibility = ["//platform:__subpackages__"],
)

# -----------------------------------------------------------------------------
# Empty mount-point / SONiC-runtime directories that debootstrap + build_debian
# create but no package owns (flatten drops empty dirs otherwise). Modes from
# fsroot-vs (all 0755). host/ is the SONiC persistent partition mountpoint,
# sonic/ the legacy mountpoint; media/mnt/opt/srv are FHS mount points.
# -----------------------------------------------------------------------------
tar(
    name = "dirs_layer",
    mtree = [
        "./media uid=0 gid=0 mode=0755 type=dir",
        "./mnt uid=0 gid=0 mode=0755 type=dir",
        "./opt uid=0 gid=0 mode=0755 type=dir",
        "./srv uid=0 gid=0 mode=0755 type=dir",
        "./host uid=0 gid=0 mode=0755 type=dir",
        "./sonic uid=0 gid=0 mode=0755 type=dir",
        "./var/log uid=0 gid=0 mode=0755 type=dir",
    ],
    visibility = ["//platform:__subpackages__"],
)

# -----------------------------------------------------------------------------
# SONiC host Python wheels: the wheels build_debian.sh / sonic_debian_extension
# pip-install into the host rootfs (sonic-utilities CLI under /usr/local/bin +
# their packages under /usr/local/lib/python3/dist-packages). Each wheel repo
# exposes an :install tar (py_wheel/tar convention). Third-party pip deps that
# are NOT apt python3-* packages are added via host_pip_layer.
# -----------------------------------------------------------------------------
flatten(
    name = "sonic_wheels_layer",
    deduplicate = True,
    tars = [
        ":host_pip_layer",
        "@sonic-py-common//:install",
        "@sonic-config-engine//:install",
        "@sonic-platform-common//:install",
        "@sonic-yang-models//:install",
        "@sonic-yang-mgmt//:install",
        "@sonic-host-services//:install",
        "@sonic-utilities//:install",
    ],
    visibility = ["//platform:__subpackages__"],
)

# Third-party PyPI runtime deps of the SONiC host wheels that resolve in the
# @pip_pmon9 uv hub. Deps the hub lacks (redis/bitarray/docker/filelock/
# pexpect/jsonpatch/click_log/lazy_object_proxy/www_authenticate/
# semantic_version/prettyprinter/docker_image_py) are a known gap — they are
# sonic-utilities CLI runtime deps, not boot-critical; Make pip-installs them
# from PyPI. Apt-provided python3-* deps (netifaces/pyroute2/dbus/gi/lxml/...)
# ship via base_layer.
site_packages(
    name = "host_pip_layer",
    srcs = [
        "@pip_pmon9//natsort",
        "@pip_pmon9//pyyaml",
        "@pip_pmon9//lxml",
        "@pip_pmon9//netaddr",
        "@pip_pmon9//jinja2",
        "@pip_pmon9//ijson",
        "@pip_pmon9//jsonpointer",
        "@pip_pmon9//jsondiff",
        "@pip_pmon9//tabulate",
        "@pip_pmon9//psutil",
        "@pip_pmon9//click",
        "@pip_pmon9//toposort",
        "@pip_pmon9//requests",
    ],
    venv = "docker-base-trixie",
    visibility = ["//platform:__subpackages__"],
)

# -----------------------------------------------------------------------------
# Kernel modules tree (/usr/lib/modules/<kver>): the linux-image deb's ~3800
# .ko set. Make installs the linux-image deb into the host fs; the Bazel image
# bridges the same deb via //platform/vs/kernel. Shipped here so the booted
# kernel can load drivers (the boot subset is also baked into the initrd).
# The modules_install tree root holds lib/modules/<kver>; tar --transform
# rewrites the leading lib/ to usr/lib/ (merged-usr, matching the deb).
# -----------------------------------------------------------------------------
genrule(
    name = "kernel_modules_layer",
    srcs = ["//platform/vs/kernel:modules_install"],
    outs = ["kernel_modules_layer.tar"],
    # The deb ships the .ko tree but NOT modules.dep/.alias/.symbols (its
    # postinst runs depmod). Reproduce that: copy the tree writable, run the
    # sealed depmod (kmod multicall, invoked through an argv0-named symlink),
    # then pack under usr/lib/modules (merged-usr, matching the deb).
    cmd = ("set -e; " +
           "S=$(location //platform/vs/kernel:modules_install); " +
           "W=$$(mktemp -d); B=$$(mktemp -d); " +
           "cp -a $$S/lib $$W/lib; chmod -R u+w $$W; " +
           "ln -s $$(readlink -f $(location @sonic_build_infra//kernel_host_tools:depmod)) $$B/depmod; " +
           "$$B/depmod -b $$W 6.12.41+deb13-sonic-amd64; " +
           "tar -cf $@ --owner=0 --group=0 --numeric-owner " +
           "--transform='s,^lib/,usr/lib/,' -C $$W lib; " +
           "chmod -R u+w $$W $$B; rm -rf $$W $$B"),
    tools = ["@sonic_build_infra//kernel_host_tools:depmod"],
    visibility = ["//platform:__subpackages__"],
)

# -----------------------------------------------------------------------------
# /etc/sonic/generated_services.conf: the unit list systemd-sonic-generator
# reads at boot to instantiate per-namespace container services + host-config
# services. Root-only in fsroot-vs (0600) so it is reconstructed here from the
# vs container set (the rendered .service units) + the host-config services
# the extension registers for the vs build (build_debian.sh /
# sonic_debian_extension.j2 `tee -a` sequence, vs branches only). 43 entries,
# matching the Make file line count.
# -----------------------------------------------------------------------------
genrule(
    name = "generated_services_conf",
    outs = ["generated_services.conf"],
    cmd = "printf '%s\\n' 'bgp.service' 'bmp.service' 'config-chassisdb.service' 'config-setup.service' 'dash-ha.service' 'database-chassis.service' 'database.service' 'dhcp_relay.service' 'eventd.service' 'gbsyncd.service' 'gnmi.service' 'lldp.service' 'macsec.service' 'mgmt-framework.service' 'mux.service' 'nat.service' 'otel.service' 'pmon.service' 'radv.service' 'sflow.service' 'snmp.service' 'swss.service' 'syncd.service' 'sysmgr.service' 'teamd.service' 'sed-pw-tpm-recovery.service' 'warmboot-finalizer.service' 'watchdog-control.service' 'rsyslog-config.service' 'system-health.service' 'logrotate-config.service' 'interfaces-config.service' 'copp-config.service' 'dhcp_dos_logger.service' 'resolv-config.service' 'hostname-config.service' 'banner-config.service' 'topology.service' 'config-topology.service' 'tacacs-config.timer' 'tacacs-config.service' 'backend-acl.service' 'pcie-check.service' > $@",
)

tar(
    name = "generated_services_layer",
    srcs = [":generated_services_conf"],
    mtree = [
        "./etc/sonic/generated_services.conf uid=0 gid=0 mode=0600 type=file content=$(location :generated_services_conf)",
    ],
    visibility = ["//platform:__subpackages__"],
)
