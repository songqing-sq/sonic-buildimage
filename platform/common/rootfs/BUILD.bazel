# -----------------------------------------------------------------------------
# Kernel modules tree (/usr/lib/modules/<kver>): the linux-image deb's ~3800
# .ko set. Make installs the linux-image deb into the host fs; the Bazel image
# bridges the same deb via //platform/vs/kernel. Shipped here so the booted
# kernel can load drivers (the boot subset is also baked into the initrd).
# The modules_install tree root holds lib/modules/<kver>; tar --transform
# rewrites the leading lib/ to usr/lib/ (merged-usr, matching the deb).
# -----------------------------------------------------------------------------
genrule(
    name = "kernel_modules_layer",
    srcs = ["//platform/vs/kernel:modules_install"],
    outs = ["kernel_modules_layer.tar"],
    # The deb ships the .ko tree but NOT modules.dep/.alias/.symbols (its
    # postinst runs depmod). Reproduce that: copy the tree writable, run the
    # sealed depmod (kmod multicall, invoked through an argv0-named symlink),
    # then pack under usr/lib/modules (merged-usr, matching the deb).
    cmd = ("set -e; " +
           "S=$(location //platform/vs/kernel:modules_install); " +
           "W=$$(mktemp -d); B=$$(mktemp -d); " +
           "cp -aL $$S/lib $$W/lib; chmod -R u+w $$W; " +
           "ln -s $$(readlink -f $(location @sonic_build_infra//kernel_host_tools:depmod)) $$B/depmod; " +
           "$$B/depmod -b $$W 6.12.41+deb13-sonic-amd64; " +
           "tar -cf $@ --owner=0 --group=0 --numeric-owner " +
           "--transform='s,^lib/,usr/lib/,' -C $$W lib; " +
           "chmod -R u+w $$W $$B; rm -rf $$W $$B"),
    tools = ["@sonic_build_infra//kernel_host_tools:depmod"],
    visibility = ["//platform:__subpackages__"],
)

# -----------------------------------------------------------------------------
# /etc/sonic/generated_services.conf: the unit list systemd-sonic-generator
# reads at boot to instantiate per-namespace container services + host-config
# services. Root-only in fsroot-vs (0600) so it is reconstructed here from the
# vs container set (the rendered .service units) + the host-config services
# the extension registers for the vs build (build_debian.sh /
# sonic_debian_extension.j2 `tee -a` sequence, vs branches only). 43 entries,
# matching the Make file line count.
# -----------------------------------------------------------------------------
genrule(
    name = "generated_services_conf",
    outs = ["generated_services.conf"],
    cmd = "printf '%s\\n' 'bgp.service' 'bmp.service' 'config-chassisdb.service' 'config-setup.service' 'dash-ha.service' 'database-chassis.service' 'database.service' 'dhcp_relay.service' 'eventd.service' 'gbsyncd.service' 'gnmi.service' 'lldp.service' 'macsec.service' 'mgmt-framework.service' 'mux.service' 'nat.service' 'otel.service' 'pmon.service' 'radv.service' 'sflow.service' 'snmp.service' 'swss.service' 'syncd.service' 'sysmgr.service' 'teamd.service' 'sed-pw-tpm-recovery.service' 'warmboot-finalizer.service' 'watchdog-control.service' 'rsyslog-config.service' 'system-health.service' 'logrotate-config.service' 'interfaces-config.service' 'copp-config.service' 'dhcp_dos_logger.service' 'resolv-config.service' 'hostname-config.service' 'banner-config.service' 'topology.service' 'config-topology.service' 'tacacs-config.timer' 'tacacs-config.service' 'backend-acl.service' 'pcie-check.service' > $@",
)

# sonic-package-manager's ServiceCreator writes four more /etc/sonic files when
# each built-in package is "installed" during the Make image build. Bazel never
# runs sonic-package-manager, so they are generated here from the same source of
# truth — the per-container manifest.json service stanzas:
#
#   {fast,warm}-reboot_order  toposort_flatten of the shutdown graph built from
#       every manifest's {fast,warm}-shutdown after/before lists. For the vs
#       container set both orders come out identical (bgp after radv/before
#       swss; lldp/mux/nat/sflow before swss; swss before syncd; dash-ha and
#       teamd after swss/before syncd), and match Make's files byte for byte.
#   swss_dependent            update_dependent_list_file: services declaring
#       `dependent-of: [swss]` — only dhcp_relay does.
#   <svc>_reconcile           generate_service_reconciliation_file: the space-
#       joined list of processes with `reconciles: true`. dhcp_relay and macsec
#       are the only packages with a reconcile file at all, and both are EMPTY
#       (0 bytes) because neither manifest marks any process as reconciling —
#       finalize-warmboot.sh only needs the file to exist.
SPM_FILES = {
    "fast-reboot_order": "lldp mux nat radv sflow bgp swss dash-ha teamd syncd",
    "warm-reboot_order": "lldp mux nat radv sflow bgp swss dash-ha teamd syncd",
    "swss_dependent": "dhcp_relay",
    "dhcp_relay_reconcile": "",
    "macsec_reconcile": "",
}

[
    genrule(
        name = "spm_" + name.replace("-", "_"),
        outs = ["spm/" + name],
        # No trailing newline: ServiceCreator uses file.write(' '.join(...)).
        cmd = "printf '%s' '{}' > $@".format(content),
    )
    for name, content in SPM_FILES.items()
]

tar(
    name = "generated_services_layer",
    srcs = [":generated_services_conf"] + [
        ":spm_" + f.replace("-", "_")
        for f in SPM_FILES
    ],
    mtree = [
        "./etc/sonic/generated_services.conf uid=0 gid=0 mode=0600 type=file content=$(location :generated_services_conf)",
    ] + [
        "./etc/sonic/{} uid=0 gid=0 mode=0644 type=file content=$(location :spm_{})".format(f, f.replace("-", "_"))
        for f in SPM_FILES
    ] + [
        # sonic_debian_extension.j2:1315-1320: mkdir /etc/sonic/frr + two empty
        # conf files, owned by the FRR uid/gid (300) with 0750 dir / 0640 files.
        "./etc/sonic/frr uid=300 gid=300 mode=0750 type=dir",
        "./etc/sonic/frr/frr.conf uid=300 gid=300 mode=0640 type=file",
        "./etc/sonic/frr/vtysh.conf uid=300 gid=300 mode=0640 type=file",
    ],
    visibility = ["//platform:__subpackages__"],
)
