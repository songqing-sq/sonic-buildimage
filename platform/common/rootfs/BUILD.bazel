        "@pip_util2//urllib3",
        "@pip_util2//www_authenticate",
        "@pip_util2//xmltodict",
        # Reachable in the hub and present in Make's host rootfs (pulled in as
        # transitive deps of the pmon/config-engine wheels rather than named by
        # sonic-utilities directly).
        "@pip_util2//blkinfo",
        "@pip_util2//grpcio",
