# -----------------------------------------------------------------------------
# systemd enable/mask symlink farm (95 links): the exact
# /etc/systemd/system/**/*.{service,timer,socket,target} symlinks the Make
# build ends up with after `systemctl enable` (sonic.target + hostcfgd/
# featured/caclmgrd/... under sonic.target.wants, docker/containerd/monit/
# rsyslog/... under multi-user.target.wants) and the masks (-> /dev/null, e.g.
# dhcp_relay.service, per-dpu dash-ha@). Snapshotted from fsroot-vs so the
# booted unit graph matches Make exactly.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# What ca-certificates' postinst (update-ca-certificates) would produce:
# /etc/ca-certificates.conf listing every shipped cert, /etc/ssl/certs' two
# levels of symlinks (<Name>.pem -> the mozilla .crt, <subject-hash>.0 -> the
# .pem) and the concatenated ca-certificates.crt bundle. Without this, anything
# doing TLS against the system trust store fails.
#
# openssl for the subject hashes is the same pinned Debian-snapshot binary the
# kernel module signing uses — nothing from the host.
# -----------------------------------------------------------------------------
genrule(
    name = "ca_certificates_layer",
    srcs = ["@trixie//ca-certificates:data"],
    outs = ["ca_certificates_layer.tar"],
    cmd = ("set -euo pipefail; " +
           "OUT=$$(realpath $(RULEDIR)); " +
           "W=$$OUT/_cacerts; rm -rf $$W; " +
           "mkdir -p $$W/src $$W/root/etc/ssl/certs $$W/bin; " +
           "tar -xzf $(location @trixie//ca-certificates:data) -C $$W/src; " +
           "cp $(location @sonic_build_infra//kernel_host_tools:openssl_bin) $$W/bin/openssl; " +
           "chmod +x $$W/bin/openssl; " +
           "for f in $(locations @sonic_build_infra//kernel_host_tools:openssl_libs); do " +
           "  cp $$f $$W/bin/; done; " +
           # openssl is a trixie binary. LD_LIBRARY_PATH alone would supply
           # libssl/libcrypto but still resolve libc.so.6 against the BUILD
           # HOST's /lib64, so it dies wherever the host glibc is older than
           # trixie's. Run it through the UNPACKED ld.so with an explicit
           # --library-path instead, so nothing here depends on the host libc.
           "OPENSSL=\"$$W/bin/ld-linux-x86-64.so.2 --library-path $$W/bin " +
           "  $$W/bin/openssl\"; " +
           "CONF=$$W/root/etc/ca-certificates.conf; " +
           "{ echo '# This file lists certificates that you wish to use or to ignore to be'; " +
           "  echo '# installed in /etc/ssl/certs.'; " +
           "  echo '# update-ca-certificates(8) will update /etc/ssl/certs by reading this file.'; " +
           "  echo '#'; " +
           "  echo '# This is autogenerated by dpkg-reconfigure ca-certificates.'; " +
           "  echo '# Certificates should be installed under /usr/share/ca-certificates'; " +
           "  echo \"# and files with extension '.crt' is recognized as available certs.\"; " +
           "  echo '#'; " +
           "  echo '# line begins with # is comment.'; " +
           "  echo '# line begins with ! is certificate filename to be deselected.'; " +
           "  echo '#'; " +
           "} > $$CONF; " +
           "( cd $$W/src/usr/share/ca-certificates && " +
           "  find . -name '*.crt' | sed 's|^\\./||' | LC_ALL=C sort ) >> $$CONF; " +
           "grep -v '^#' $$CONF | while IFS= read -r line; do " +
           "  test -n \"$$line\" || continue; " +
           "  base=$$(basename $$line .crt); " +
           "  ln -sf /usr/share/ca-certificates/$$line $$W/root/etc/ssl/certs/$$base.pem; " +
           "  cat $$W/src/usr/share/ca-certificates/$$line " +
           "    >> $$W/root/etc/ssl/certs/ca-certificates.crt; " +
           "done; " +
           "( cd $$W/root/etc/ssl/certs; " +
           "  for pem in *.pem; do " +
           "    tgt=$$W/src$$(readlink $$pem); " +
           "    h=$$($$OPENSSL x509 -hash -noout -in $$tgt); " +
           "    n=0; while [ -e $$h.$$n ]; do n=$$((n+1)); done; " +
           "    ln -sf $$pem $$h.$$n; " +
           "  done ); " +
           "tar -cf $@ --owner=0 --group=0 --numeric-owner --sort=name -C $$W/root .; " +
           "rm -rf $$W"),
    tools = [
        "@sonic_build_infra//kernel_host_tools:openssl_bin",
        "@sonic_build_infra//kernel_host_tools:openssl_libs",
    ],
    visibility = ["//visibility:public"],
)

# -----------------------------------------------------------------------------
# ucf-managed conffiles. Five packages install their /etc configs via `ucf` in
# postinst rather than as dpkg conffiles, so unpacking data tars leaves the
# files missing entirely (fsroot-vs/var/lib/ucf/registry is the ground truth
# list). Reproduced here from each package's in-deb template:
#   /etc/ssh/sshd_config      <- FIPS openssh-server's usr/share/openssh
#                                template + build_debian.sh's augtool/sed edits
#                                (UseDNS, ClientAlive*, Banner, ListenAddress…)
#   /etc/chrony/chrony.conf   <- usr/share/chrony copies; keys is root:_chrony
#   /etc/chrony/chrony.keys      0640 (postinst chown, gid 105 in files/group)
#   /etc/default/sysstat      <- heredoc generated by sysstat's postinst
#                                (debconf default ENABLED="false")
#   /etc/default/kdump-tools  <- kdump-tools' usr/share template + the SONiC
#                                appendix sonic_debian_extension.j2 tees on
# /var/lib/ucf/{registry,hashfile} (+ rotation backups .0-.4 from the five
# sequential registrations) are included so future `ucf` runs on upgraded
# systems make the same keep/replace decisions as on a Make-built image.
# -----------------------------------------------------------------------------
genrule(
    name = "ucf_layer",
    srcs = [
        "@sonic-fips//:openssh-server_10.0p1-7+fips.deb_data",
        "@trixie//chrony:data",
        "@kdump-tools//:gen_kdump_tools_conf",
        "//files/image_config:kdump/kdump-tools",
    ],
    outs = ["ucf_layer.tar"],
    cmd = ("set -euo pipefail; " +
           "OUTTAR=$$(realpath $(RULEDIR))/$$(basename $@); " +
           "W=$$(realpath $(RULEDIR))/_ucf; rm -rf $$W; " +
           "mkdir -p $$W/src $$W/root/etc/ssh $$W/root/etc/chrony " +
           "  $$W/root/etc/default $$W/root/var/lib/ucf/cache; " +
           "tar -xzf $(location @sonic-fips//:openssh-server_10.0p1-7+fips.deb_data) " +
           "  -C $$W/src ./usr/share/openssh/sshd_config; " +
           "tar -xzf $(location @trixie//chrony:data) -C $$W/src " +
           "  ./usr/share/chrony/chrony.conf ./usr/share/chrony/chrony.keys; " +
           # sshd_config: build_debian.sh's two sed edits + augtool append block.
           "sed -e 's/^#ListenAddress 0.0.0.0/ListenAddress 0.0.0.0/' " +
           "    -e 's/^#ListenAddress ::/ListenAddress ::/' " +
           "  $$W/src/usr/share/openssh/sshd_config > $$W/root/etc/ssh/sshd_config; " +
           "{ echo; " +
           "  echo '# Disable hostname lookups'; " +
           "  echo 'UseDNS no'; " +
           "  echo; " +
           "  echo '# Close inactive client sessions after 5 minutes'; " +
           "  echo 'ClientAliveInterval 300'; " +
           "  echo 'ClientAliveCountMax 0'; " +
           "  echo 'MaxAuthTries 3'; " +
           "  echo 'Banner /etc/issue'; " +
           "  echo 'LogLevel VERBOSE'; " +
           "  echo '# Deny SSH login with empty password; use console to set a real password first'; " +
           "  echo 'PermitEmptyPasswords no'; " +
           "  echo '# Disable SSH agent forwarding - not required for SONiC operation'; " +
           "  echo 'AllowAgentForwarding no'; " +
           "} >> $$W/root/etc/ssh/sshd_config; " +
           "cp $$W/src/usr/share/chrony/chrony.conf $$W/root/etc/chrony/chrony.conf; " +
           "cp $$W/src/usr/share/chrony/chrony.keys $$W/root/etc/chrony/chrony.keys; " +
           # sysstat postinst's manage_default_file heredoc, ENABLED="false".
           "{ echo '#'; " +
           "  echo '# Default settings for /etc/init.d/sysstat, /etc/cron.d/sysstat'; " +
           "  echo '# and /etc/cron.daily/sysstat files'; " +
           "  echo '#'; " +
           "  echo; " +
           "  echo '# Should sadc collect system activity informations? Valid values'; " +
           "  echo '# are \"true\" and \"false\". Please do not put other values, they'; " +
           "  echo '# will be overwritten by debconf!'; " +
           "  echo 'ENABLED=\"false\"'; " +
           "  echo; " +
           "} > $$W/root/etc/default/sysstat; " +
           "KDUMP_TMPL=$$(realpath $(location @kdump-tools//:gen_kdump_tools_conf)); " +
           "cat $(location @kdump-tools//:gen_kdump_tools_conf) " +
           "    $(location //files/image_config:kdump/kdump-tools) " +
           "  > $$W/root/etc/default/kdump-tools; " +
           # ucf registry/hashfile plus the .N backups each registration rotates.
           "cd $$W/root; " +
           "R=var/lib/ucf/registry; " +
           "printf 'sysstat \\t /etc/default/sysstat\\n' > $$R; " +
           "cp $$R $$R.3; " +
           "printf 'openssh-server \\t /etc/ssh/sshd_config\\n' >> $$R; " +
           "cp $$R $$R.2; " +
           "printf 'chrony \\t /etc/chrony/chrony.conf\\n' >> $$R; " +
           "cp $$R $$R.1; " +
           "printf 'chrony \\t /etc/chrony/chrony.keys\\n' >> $$R; " +
           "cp $$R $$R.0; " +
           "printf 'kdump-tools \\t /etc/default/kdump-tools\\n' >> $$R; " +
           ": > $$R.4; " +
           # ucf hashes the *template* at registration time; SONiC's later
           # augtool/tee edits to sshd_config and kdump-tools are not re-run
           # through ucf, so those two entries keep the pristine template md5.
           "H=var/lib/ucf/hashfile; : > $$H; " +
           "while read -r pkg path; do " +
           "  case $$path in " +
           "    /etc/ssh/sshd_config) src=$$W/src/usr/share/openssh/sshd_config;; " +
           "    /etc/default/kdump-tools) src=$$KDUMP_TMPL;; " +
           "    *) src=.$$path;; " +
           "  esac; " +
           "  printf '%s  %s\\n' $$(md5sum $$src | cut -d' ' -f1) $$path >> $$H; " +
           "done < $$R; " +
           "head -4 $$H > $$H.0; " +
           # /var/lib/ucf/cache/<mangled-path>: ucf keeps the DISTRIBUTOR's
           # version of each conffile here (path with / -> :), and diffs the
           # live file against it on the next upgrade to decide whether the
           # admin edited it. Missing cache = ucf treats every file as
           # locally modified and stops managing it.
           "mkdir -p var/lib/ucf/cache; " +
           "cp $$W/src/usr/share/openssh/sshd_config " +
           "  var/lib/ucf/cache/:etc:ssh:sshd_config; " +
           "cp $$W/src/usr/share/chrony/chrony.conf " +
           "  var/lib/ucf/cache/:etc:chrony:chrony.conf; " +
           "cp $$W/src/usr/share/chrony/chrony.keys " +
           "  var/lib/ucf/cache/:etc:chrony:chrony.keys; " +
           "cp $$KDUMP_TMPL var/lib/ucf/cache/:etc:default:kdump-tools; " +
           # sysstat's cache is the postinst heredoc, i.e. the file we just
           # generated -- there is no shipped template for it.
           "cp etc/default/sysstat var/lib/ucf/cache/:etc:default:sysstat; " +
           # ucf copies each cache entry with the source file's own mode, so
           # sshd_config/chrony.conf/kdump-tools land 0644, chrony.keys 0640
           # (its /etc mode) and sysstat 0600 (mktemp's).
           "chmod 644 var/lib/ucf/cache/*; " +
           "chmod 640 var/lib/ucf/cache/:etc:chrony:chrony.keys; " +
           "chmod 600 var/lib/ucf/cache/:etc:default:sysstat; " +
           "chmod 644 etc/ssh/sshd_config etc/chrony/chrony.conf " +
           "  etc/default/sysstat etc/default/kdump-tools; " +
           "chmod 640 etc/chrony/chrony.keys; " +
           "tar -cf $$OUTTAR --owner=0 --group=0 --numeric-owner --sort=name " +
           "  --exclude=./etc/chrony/chrony.keys .; " +
           "tar -rf $$OUTTAR --owner=0 --group=105 --numeric-owner ./etc/chrony/chrony.keys; " +
           "rm -rf $$W"),
    visibility = ["//platform:__subpackages__"],
)

# -----------------------------------------------------------------------------
# update-alternatives symlinks. The deb layers unpack data tars without running
# maintainer scripts, so dpkg's alternatives system never runs; without these,
# /usr/bin/awk, /usr/bin/vi, /usr/sbin/iptables etc. simply do not exist and
# anything invoking them by generic name breaks. Tables in alternatives.bzl are
# read from the Make fsroot baseline.
# -----------------------------------------------------------------------------
tar(
    name = "alternatives_layer",
    mtree = [
        "./etc/alternatives/{} uid=0 gid=0 type=link link={}".format(name, target)
        for name, target in ALTERNATIVES.items()
    ] + [
        ".{} uid=0 gid=0 type=link link={}".format(path, target)
        for path, target in ALTERNATIVE_BINS.items()
    ],
    visibility = ["//platform:__subpackages__"],
)

# SysV rc*.d links normally created by each package postinst's `update-rc.d`
# call (see rcd_links.bzl for why they're pinned).
tar(
    name = "rcd_links_layer",
    mtree = [
        ".{} uid=0 gid=0 type=link link={}".format(path, target)
        for path, target in RCD_LINKS
    ],
    visibility = ["//platform:__subpackages__"],
)

# deb-systemd-helper's enable bookkeeping (see dsh_state.bzl for why it matters
# on upgrade). write_file rather than a printf in a genrule: the .dsh-also
# bodies are newline-separated path lists, and `printf '%s'` does not interpret
# escapes, so passing them through a shell string silently writes a literal
# backslash-n.
[
    write_file(
        name = "dsh_" + path.replace("/", "__").replace(".", "_").replace("-", "_"),
        out = "dsh/" + path,
        content = content.split("\n") if content else [],
        newline = "unix",
    )
    for path, content in DSH_FILES.items()
]

tar(
    name = "dsh_state_layer",
    srcs = [
        ":dsh_" + p.replace("/", "__").replace(".", "_").replace("-", "_")
        for p in DSH_FILES
    ],
    mtree = [
        ("./var/lib/systemd/deb-systemd-helper-enabled/{p} uid=0 gid=0 " +
         "mode=0644 type=file content=$(location :dsh_{n})").format(
            p = path,
            n = path.replace("/", "__").replace(".", "_").replace("-", "_"),
        )
        for path in DSH_FILES
    ],
    visibility = ["//platform:__subpackages__"],
)

