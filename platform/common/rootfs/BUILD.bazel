# =============================================================================
# Host (vs) rootfs layers for the Bazel-built sonic-vs.bin.
#
# Ground truth: the Make build's fsroot-vs/ tree (built by build_debian.sh +
# files/build_templates/sonic_debian_extension.j2). Every layer's content is
# derived from what Make actually laid into fsroot-vs, NOT re-imagined.
#
# Layer order (consumed by sonic_onie_image via sonic_squashfs; later layers
# overwrite earlier ones):
#   base_layer          Debian closure (431 pkgs = fsroot dpkg status minus
#                       SONiC debs minus docker-ce family) + dpkg status
#   docker_engine_layer docker-ce/docker-ce-cli/containerd.io (download.docker.com)
#   sonic_debs_layer    the SONiC-built host packages (hermetic sonic_deb)
#   passwd/group/shadow exact fsroot-vs /etc identities
#   host_config_layer   hostname/hosts/fstab + docker drop-ins
#   ...                 (scripts/templates/etc/version/systemd layers follow)
# =============================================================================

# /var/lib/dpkg/status for every Debian package in the closure, so dpkg -l /
# apt work on the booted host (parity with the Make chroot install).
dpkg_status(
    name = "dpkg_status",
    controls = ["@trixie//{}:control".format(p) for p in HOST_PACKAGES],
)

# /var/lib/dpkg/info/<pkg>[:<arch>].{list,md5sums} plus the maintainer scripts
# and control-tar metadata dpkg records at unpack time. Without them `dpkg -L`
# returns nothing for any Debian package and `debsums` cannot verify anything.
#
# All of it is already in the debs: .list is the data tar's path listing
# normalized to dpkg's form (absolute, no trailing slash, "/." for the root),
# and md5sums / triggers / shlibs / symbols / conffiles / {pre,post}{inst,rm}
# are control-tar members copied verbatim.
#
# The name carries a `:<arch>` suffix exactly when the package is
# `Multi-Arch: same` (dpkg needs to keep per-arch instances apart); `foreign`
# and unset get the bare name. That is read from each package's own control.
genrule(
    name = "dpkg_info_files",
    srcs = ["@trixie//{}:control".format(p) for p in HOST_PACKAGES] +
           ["@trixie//{}:data".format(p) for p in HOST_PACKAGES],
    outs = ["dpkg_info.tar"],
    # The control tar and the data tar of one package do NOT live in the same
    # directory in the sandbox (control.tar.xz is staged under external/, the
    # data tar under bazel-out/), so they are emitted as explicit
    # "<control> <data>" pairs rather than paired by dirname at runtime.
    cmd = ("set -euo pipefail; " +
           "OUT=$$(realpath $(RULEDIR))/$$(basename $@); " +
           "W=$$(mktemp -d); trap 'rm -rf $$W' EXIT; " +
           "I=$$W/var/lib/dpkg/info; mkdir -p $$I; " +
           "while read -r ctl dat; do " +
           "  [ -n \"$$ctl\" ] || continue; " +
           "  C=$$W/_c; rm -rf $$C; mkdir -p $$C; " +
           "  tar -xf $$ctl -C $$C; " +
           "  pkg=$$(sed -n 's/^Package: //p' $$C/control | head -1); " +
           "  ma=$$(sed -n 's/^Multi-Arch: //p' $$C/control | head -1); " +
           "  arch=$$(sed -n 's/^Architecture: //p' $$C/control | head -1); " +
           "  n=$$pkg; " +
           "  if [ \"$$ma\" = same ]; then n=\"$$pkg:$$arch\"; fi; " +
           # .list in dpkg's own form: "/." for the root, absolute paths, no
           # trailing slash on directories.
           # --quoting-style=literal: without it tar octal-escapes non-ASCII
           # names (the ca-certificates mozilla bundle has several).
           "  tar --quoting-style=literal -tf $$dat " +
           "    | sed -e 's|^\\./$$|/.|' -e 's|^\\./|/|' -e 's|\\(.\\)/$$|\\1|' " +
           "    > $$I/$$n.list; " +
           "  for m in md5sums triggers shlibs symbols conffiles " +
           "           preinst postinst prerm postrm; do " +
           "    if [ -f $$C/$$m ]; then cp $$C/$$m $$I/$$n.$$m; fi; " +
           "  done; " +
           "done <<'PAIRS'\n" +
           "".join([
               "$(location @trixie//{p}:control) $(location @trixie//{p}:data)\n".format(p = p)
               for p in HOST_PACKAGES
           ]) +
           "PAIRS\n" +
           "chmod 644 $$I/*; " +
           "chmod 755 $$I/*.preinst $$I/*.postinst $$I/*.prerm $$I/*.postrm " +
           "  2>/dev/null || true; " +
           "tar -cf $$OUT --owner=0 --group=0 --numeric-owner --sort=name " +
           "  -C $$W var"),
)

# Same treatment for the SONiC-built and FIPS host debs. Their control tars are
# exposed under three different target names depending on which macro built the
# deb (sonic_deb: `_control`, external_fips_deb: `_extract_control`, some: none
# at all), so read the .deb itself with `dpkg-deb` -- every one of them is a
# plain deb file target, which is the one thing they all have in common.
genrule(
    name = "sonic_dpkg_info_files",
    srcs = list(HERMETIC_HOST_DEBS.values()) + list(FIPS_HOST_DEBS.values()),
    outs = ["sonic_dpkg_info.tar"],
    cmd = ("set -euo pipefail; " +
           "OUT=$$(realpath $(RULEDIR))/$$(basename $@); " +
           "W=$$(mktemp -d); trap 'rm -rf $$W' EXIT; " +
           "I=$$W/var/lib/dpkg/info; mkdir -p $$I; " +
           "for deb in $(SRCS); do " +
           "  C=$$W/_c; rm -rf $$C; mkdir -p $$C; " +
           "  dpkg-deb --control $$deb $$C; " +
           "  pkg=$$(sed -n 's/^Package: //p' $$C/control | head -1); " +
           "  ma=$$(sed -n 's/^Multi-Arch: //p' $$C/control | head -1); " +
           "  arch=$$(sed -n 's/^Architecture: //p' $$C/control | head -1); " +
           "  n=$$pkg; " +
           "  if [ \"$$ma\" = same ]; then n=\"$$pkg:$$arch\"; fi; " +
           # dpkg always records "/." first. sonic_deb's data tars omit the
           # "./" root member, so emit it unconditionally and drop any that the
           # tar does carry, rather than relying on the member being present.
           "  { echo '/.'; dpkg-deb --fsys-tarfile $$deb " +
           "      | tar --quoting-style=literal -tf - " +
           "      | sed -e '/^\\.\\/$$/d' -e 's|^\\./|/|' -e 's|\\(.\\)/$$|\\1|'; " +
           "  } > $$I/$$n.list; " +
           "  for m in md5sums triggers shlibs symbols conffiles " +
           "           preinst postinst prerm postrm; do " +
           "    if [ -f $$C/$$m ]; then cp $$C/$$m $$I/$$n.$$m; fi; " +
           "  done; " +
           "done; " +
           "chmod 644 $$I/*; " +
           "chmod 755 $$I/*.preinst $$I/*.postinst $$I/*.prerm $$I/*.postrm " +
           "  2>/dev/null || true; " +
           "tar -cf $$OUT --owner=0 --group=0 --numeric-owner --sort=name " +
           "  -C $$W var"),
    visibility = ["//platform:__subpackages__"],
)

alias(
    name = "dpkg_info_layer",
    actual = ":dpkg_info_files",
    visibility = ["//platform:__subpackages__"],
)

# vim + apt-transport-https: bridged as http_file debs (see MODULE.bazel —
# trixie virtual providers shadow the real packages in the apt resolver).
[
    genrule(
        name = "bridged_deb_" + n,
        srcs = [lbl],
        outs = ["bridged_deb_" + n + ".tar"],
        cmd = "dpkg-deb --fsys-tarfile $(location {lbl}) > $@".format(lbl = lbl),
    )
    for n, lbl in {
        "vim": "@vim_deb//file",
        "apt_transport_https": "@apt_transport_https_deb//file",
    }.items()
]

# -----------------------------------------------------------------------------
# /var/run -> /run and /var/lock -> /run/lock. base-files' postinst runs
#   migrate_directory /var/run  /run
#   migrate_directory /var/lock /run/lock
# replacing the two directories its own data.tar ships with symlinks. Bazel
# never runs that postinst, so without this layer /var/run stays a real
# directory and two things break: libswsscommon's deb materialises
# /var/run/redis/sonic-db/database_config.json as a real file that /run never
# sees, and /var/run/docker.sock does not resolve to the socket dockerd
# actually creates at /run/docker.sock -- so every `docker` call fails with
# "Cannot connect to the Docker daemon" and every SONiC container service dies.
#
# MUST be the FIRST layer in rootfs_layers: tar --keep-directory-symlink only
# follows a symlink that already exists, so this is what redirects the later
# deb layers' /var/run content into /run.
#
# The links are relative where Debian's are absolute: the rootfs is assembled in
# a build tmpdir, and an absolute /run target escapes it to the build host's own
# /run (extraction then dies with "Cannot mkdir: Permission denied"). ../run
# resolves to the same path at runtime.
# -----------------------------------------------------------------------------
tar(
    name = "varrun_layer",
    mtree = [
        "./var uid=0 gid=0 mode=0755 type=dir",
        "./run uid=0 gid=0 mode=0755 type=dir",
        "./run/lock uid=0 gid=0 mode=01777 type=dir",
        "./var/run uid=0 gid=0 type=link link=../run",
        "./var/lock uid=0 gid=0 type=link link=../run/lock",
    ],
    visibility = ["//platform:__subpackages__"],
)

# The Debian host package closure. HOST_PACKAGES is already the FULL closure
# (taken verbatim from fsroot-vs dpkg status), so `:data` tars (own package
# contents, no transitive re-resolution) reproduce the exact Make file set and
# avoid the rules_distroless Arch:all mixed-arch leak of the bare labels.
flatten(
    name = "base_layer",
    deduplicate = True,
    tars = ["@trixie//{}:data".format(p) for p in HOST_PACKAGES] + [
        ":bridged_deb_vim",
        ":bridged_deb_apt_transport_https",
        ":dpkg_status",
    ],
    visibility = ["//platform:__subpackages__"],
)

# -----------------------------------------------------------------------------
# Docker engine: build_debian.sh installs docker-ce/docker-ce-cli/containerd.io
# from download.docker.com (bridged as pinned http_file debs in MODULE.bazel;
# versions match fsroot-vs dpkg status). Their Debian deps (iptables, nftables,
# libseccomp2, libsystemd0, ...) are already in HOST_PACKAGES.
# Extract each deb's data.tar into a plain tar for the flatten pipeline.
# -----------------------------------------------------------------------------
[
    genrule(
        name = "docker_deb_" + n,
        srcs = [lbl],
        outs = ["docker_deb_" + n + ".tar"],
        cmd = ("d=$$(mktemp -d); dpkg-deb --fsys-tarfile $(location {lbl}) > $@.tmp; " +
               "mv $@.tmp $@; rm -rf $$d").format(lbl = lbl),
    )
    for n, lbl in {
        "ce": "@docker_ce_deb//file",
        "ce_cli": "@docker_ce_cli_deb//file",
        "containerd": "@containerd_io_deb//file",
    }.items()
]

flatten(
    name = "docker_engine_layer",
    deduplicate = True,
    tars = [
        ":docker_deb_ce",
        ":docker_deb_ce_cli",
        ":docker_deb_containerd",
    ],
    visibility = ["//platform:__subpackages__"],
)

# -----------------------------------------------------------------------------
# SONiC-built host packages: laid in from their HERMETIC sonic_deb targets
# (each package's `_data` tar = the deb's contents, `_statusd` = its
# /var/lib/dpkg/status.d entry). Nothing here reads target/debs — that is a
# Make artifact.
#
# The set of packages the host fs needs comes from the Make fsroot-vs dpkg
# status; sonic_host_debs.bzl records, per package, whether it is built from
# source here (HERMETIC_HOST_DEBS), fetched prebuilt from the SONiC FIPS mirror
# (FIPS_HOST_DEBS), or still awaiting migration (TODO_HERMETIC).
# -----------------------------------------------------------------------------
exports_files(["BUILD.bazel"])

flatten(
    name = "sonic_debs_layer",
    deduplicate = True,
    tars = [d + "_data" for d in HERMETIC_HOST_DEBS.values()] +
           [d + "_statusd" for d in HERMETIC_HOST_DEBS.values()] +
           [d + "_data" for d in FIPS_HOST_DEBS.values()] +
           [d + "_statusd" for d in FIPS_HOST_DEBS.values()] +
           [t for pair in HERMETIC_HOST_DEB_DATA_TARS.values() for t in pair],
    visibility = ["//platform:__subpackages__"],
)

# -----------------------------------------------------------------------------
# Identity: /etc/passwd, /etc/group, /etc/shadow copied from the Make
# fsroot-vs truth (all the users build_debian.sh + maintainer scripts created:
# admin/uid 1000 in sudo+docker+redis groups, messagebus, sshd, _chrony, tss,
# nslcd, ...). shadow is regenerated: system users locked with '*', admin
# carries the SHA-512 hash of rules/config DEFAULT_PASSWORD (YourPaSsWoRd).
# -----------------------------------------------------------------------------
tar(
    name = "passwd",
    srcs = ["files/passwd"],
    mtree = [
        "./etc/passwd uid=0 gid=0 mode=0644 type=file content=$(location files/passwd)",
    ],
    visibility = ["//platform:__subpackages__"],
)

tar(
    name = "group",
    srcs = ["files/group"],
    mtree = [
        "./etc/group uid=0 gid=0 mode=0644 type=file content=$(location files/group)",
    ],
    visibility = ["//platform:__subpackages__"],
)

tar(
    name = "shadow_layer",
    srcs = ["files/shadow"],
    mtree = [
        "./etc/shadow uid=0 gid=42 mode=0600 type=file content=$(location files/shadow)",
    ],
    visibility = ["//platform:__subpackages__"],
)

# -----------------------------------------------------------------------------
# Host identity/mount config (build_debian.sh writes these directly) + the
# docker daemon drop-ins:
#   /etc/systemd/system/docker.service.d/docker.service.conf (build_debian.sh:290)
#   DOCKER_OPTS append to /etc/default/docker (sonic_debian_extension.j2:69)
#     — shipped as a one-line override file content matching fsroot-vs tail.
# -----------------------------------------------------------------------------
tar(
    name = "host_config_layer",
    srcs = [
        "files/hostname",
        "files/hosts",
        "files/fstab",
        "//files/docker:docker.service.conf",
    ],
    mtree = [
        "./etc/hostname uid=0 gid=0 mode=0644 type=file content=$(location files/hostname)",
        "./etc/hosts uid=0 gid=0 mode=0644 type=file content=$(location files/hosts)",
        "./etc/fstab uid=0 gid=0 mode=0644 type=file content=$(location files/fstab)",
        "./etc/systemd/system/docker.service.d/docker.service.conf uid=0 gid=0 mode=0644 type=file content=$(location //files/docker:docker.service.conf)",
    ],
    visibility = ["//platform:__subpackages__"],
)

# -----------------------------------------------------------------------------
# /etc/pam.d/common-{auth,account,password,session,session-noninteractive}:
# generated by `pam-auth-update`, which libpam-runtime's postinst runs to merge
# the /usr/share/pam-configs profiles (unix, systemd, pwquality, ldap, mkhomedir,
# tacplus) by priority. Nothing ships these as conffiles, so unpacking data tars
# leaves them absent — and /etc/pam.d/{sshd,login,su,sudo,cron} all
# `@include common-auth`, so PAM fails closed and NO login works at all.
#
# Rather than reimplementing pam-auth-update's merge algorithm, the exact merged
# output is checked in (verified byte-identical to fsroot-vs, which is the same
# profile set: only `unix` and `pwquality` are Default:yes plus the systemd
# session module; ldap/tacplus/mkhomedir stay inactive until AAA config enables
# them at runtime via hostcfgd's own pam-auth-update call).
# -----------------------------------------------------------------------------
tar(
    name = "pam_layer",
    srcs = glob(["files/pam.d/common-*"]) + glob(["files/pam_state/*"]),
    mtree = [
        "./etc/pam.d/{0} uid=0 gid=0 mode=0644 type=file content=$(location files/pam.d/{0})".format(f)
        for f in [
            "common-account",
            "common-auth",
            "common-password",
            "common-session",
            "common-session-noninteractive",
        ]
    ] + [
        # pam-auth-update's own state: which profile supplied each line of the
        # merged files, plus `seen` (the profiles it has already offered). On the
        # next run it diffs against this to detect local edits -- without it a
        # later `pam-auth-update` treats the merged files as hand-written and
        # refuses to touch them, so enabling TACACS+/LDAP at runtime silently
        # does nothing.
        "./var/lib/pam/{0} uid=0 gid=0 mode=0644 type=file content=$(location files/pam_state/{0})".format(f)
        for f in [
            "account",
            "auth",
            "password",
            "session",
            "session-noninteractive",
            "seen",
        ]
    ],
    visibility = ["//visibility:public"],
)

# -----------------------------------------------------------------------------
# /etc defaults that base-files / libc-bin / netbase postinsts install, and the
# /etc/shells list that each shell package's `add-shell` appends to. None are
# dpkg conffiles, so unpacking data tars leaves them absent:
#   /etc/profile       base-files postinst `install_from_default profile`
#                      — copied from the deb's /usr/share/base-files/profile
#   /etc/nsswitch.conf libc-bin postinst `install_from_default` — copied from
#                      the deb's /usr/share/libc-bin/nsswitch.conf. Without it
#                      glibc falls back to compiled-in defaults, so `files`
#                      lookups still work but nothing else does.
#   /etc/networks      netbase postinst's create_networks_file heredoc
#   /etc/shells        bash/dash/screen postinsts each `add-shell`; the union
#                      matches fsroot-vs (order = package configure order).
#                      The container variant drops /usr/bin/screen — screen is
#                      not installed in docker-base-trixie, matching Make's
#                      per-image /etc/shells exactly.
# Both templates are read from the debs themselves, not snapshotted.
# -----------------------------------------------------------------------------
[
    genrule(
        name = variant + "base_postinst_layer",
        srcs = [
            "@trixie//base-files:data",
            "@trixie//libc-bin:data",
        ],
        outs = [variant + "base_postinst_layer.tar"],
        cmd = ("set -euo pipefail; " +
               "OUTTAR=$$(realpath $(RULEDIR))/$$(basename $@); " +
               "W=$$(realpath $(RULEDIR))/_basepi" + variant + "; rm -rf $$W; " +
               "mkdir -p $$W/src $$W/root/etc; " +
               "tar -xzf $(location @trixie//base-files:data) -C $$W/src " +
               "  ./usr/share/base-files/profile; " +
               "tar -xzf $(location @trixie//libc-bin:data) -C $$W/src " +
               "  ./usr/share/libc-bin/nsswitch.conf; " +
               "cp $$W/src/usr/share/base-files/profile $$W/root/etc/profile; " +
               "cp $$W/src/usr/share/libc-bin/nsswitch.conf $$W/root/etc/nsswitch.conf; " +
               "printf 'default\\t\\t0.0.0.0\\nloopback\\t127.0.0.0\\nlink-local\\t169.254.0.0\\n\\n' " +
               "  > $$W/root/etc/networks; " +
               "{ echo '# /etc/shells: valid login shells'; " +
               "".join(["  echo '%s'; " % sh for sh in shells]) +
               "} > $$W/root/etc/shells; " +
               # /etc/machine-id: systemd's ConditionFirstBoot treats a MISSING
               # (not empty) machine-id as "first boot" and then runs
               # `systemctl preset-all`, which enables every unit carrying
               # [Install] WantedBy but no explicit preset rule -- Debian's
               # default policy is `enable`. That silently switched on ipmievd,
               # chrony-wait, topology, core_uploader and 13 more that Make
               # leaves disabled, and they then fail on every boot (no BMC, no
               # watchdog device, no multi-ASIC dir). An EMPTY file means
               # "uninitialized": systemd-machine-id-setup fills it in on first
               # boot WITHOUT the preset pass, matching Make's image.
               ("" if variant else ": > $$W/root/etc/machine-id; ") +
               "cd $$W/root; chmod 644 etc/profile etc/nsswitch.conf etc/networks etc/shells; " +
               ("" if variant else "chmod 444 etc/machine-id; ") +
               "tar -cf $$OUTTAR --owner=0 --group=0 --numeric-owner --sort=name .; " +
               "rm -rf $$W"),
        visibility = ["//visibility:public"],
    )
    for variant, shells in [
        ("", [
            "/bin/sh",
            "/usr/bin/sh",
            "/bin/bash",
            "/usr/bin/bash",
            "/bin/rbash",
            "/usr/bin/rbash",
            "/usr/bin/dash",
            "/usr/bin/screen",
        ]),
        ("container_", [
            "/bin/sh",
            "/usr/bin/sh",
            "/bin/bash",
            "/usr/bin/bash",
            "/bin/rbash",
            "/usr/bin/rbash",
            "/usr/bin/dash",
        ]),
    ]
]

# -----------------------------------------------------------------------------
# Remaining package-postinst /etc products. Each is written by a maintainer
# script that Bazel's deb layers never run:
#   /etc/bash_plugins.conf        bash-tacplus postinst appends the dlopen path
#                                 of the bash_tacplus.so it just installed. This
#                                 file is what makes the bash plugin patch (see
#                                 src/bash) actually load TACACS+ command
#                                 authorization — empty file = silent bypass.
#   /etc/iptables/rules.v{4,6}    iptables-persistent postinst runs
#                                 `ip{,6}tables-save`. Make's copies capture the
#                                 BUILD HOST's live docker chains plus a
#                                 `Generated ... on <date>` header — host state
#                                 leaking into the image. A freshly-installed
#                                 switch has no rules to persist, so empty
#                                 rulesets are shipped. KNOWN DIVERGENCE from
#                                 Make, deliberately: reproducing its content
#                                 would mean baking in the builder's docker
#                                 bridge setup.
#   /etc/tmpfiles.d/screen-cleanup.conf  screen postinst, 1777 branch (screen is
#                                 0755, not setuid, in this image).
#   /etc/default/kexec            kexec-tools postinst ucf-installs it.
#   /etc/nslcd.conf               nslcd postinst heredoc; 0640 root:nslcd (107).
#   /etc/resolvconf/resolv.conf.d/tail  resolvconf postinst `: > tail`.
# -----------------------------------------------------------------------------
genrule(
    name = "postinst_conf_files",
    outs = [
        "pc/bash_plugins.conf",
        "pc/rules.v4",
        "pc/rules.v6",
        "pc/screen-cleanup.conf",
        "pc/kexec",
        "pc/nslcd.conf",
        "pc/resolvconf_tail",
        "pc/aa_home_ubuntu",
        "pc/aa_xdg_site_local",
        "pc/aa_empty",
        "pc/fips_enable",
        "pc/tmpfs-monit.conf",
        "pc/tmpfs-logrotate.conf",
        "pc/auditd-log-directory.conf",
        "pc/initramfs_modules",
        "pc/driver-policy",
        "pc/debian_config",
        "pc/subuid",
        "pc/hosts.allow",
        "pc/hosts.deny",
        "pc/locale.conf",
        "pc/locale.gen",
        "pc/modules",
        "pc/sgml_catalog",
        "pc/xml_catalog",
        "pc/xml_core_catalog",
    ],
    cmd = ("set -euo pipefail; D=$(RULEDIR)/pc; mkdir -p $$D; " +
           "echo 'plugin=/usr/lib/x86_64-linux-gnu/security/bash_tacplus.so' " +
           "  > $$D/bash_plugins.conf; " +
           ": > $$D/rules.v4; : > $$D/rules.v6; : > $$D/resolvconf_tail; " +
           "{ echo '# This file is generated by /var/lib/dpkg/info/screen.postinst upon package configuration'; " +
           "  echo 'd /run/screen 1777 root utmp'; } > $$D/screen-cleanup.conf; " +
           "{ echo '# Defaults for kexec-tools'; echo; " +
