tar(
    name = "postinst_conf_layer",
    srcs = [":postinst_conf_files"],
    mtree = [
        "./etc/bash_plugins.conf uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/bash_plugins.conf",
        "./etc/iptables/rules.v4 uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/rules.v4",
        "./etc/iptables/rules.v6 uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/rules.v6",
        "./etc/tmpfiles.d/screen-cleanup.conf uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/screen-cleanup.conf",
        "./etc/default/kexec uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/kexec",
        "./etc/nslcd.conf uid=0 gid=107 mode=0640 type=file content=$(RULEDIR)/pc/nslcd.conf",
        "./etc/resolvconf/resolv.conf.d/tail uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/resolvconf_tail",
        "./etc/apparmor.d/tunables/home.d/ubuntu uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/aa_home_ubuntu",
        "./etc/apparmor.d/tunables/xdg-user-dirs.d/site.local uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/aa_xdg_site_local",
    ] + [
        # dh_apparmor's per-profile `local/<profile>` include stub: each profile
        # ends with `#include <local/usr.sbin.foo>`, so apparmor_parser fails to
        # load the profile if the stub is missing. All are 0-byte.
        "./etc/apparmor.d/local/{} uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/aa_empty".format(p)
        for p in [
            "lsb_release",
            "nvidia_modprobe",
            "usr.sbin.chronyd",
            "usr.sbin.dhclient",
            "usr.sbin.haveged",
        ]
    ] + [
        "./etc/fips/fips_enable uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/fips_enable",
        "./etc/tmpfiles.d/tmpfs-monit.conf uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/tmpfs-monit.conf",
        "./etc/tmpfiles.d/tmpfs-logrotate.conf uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/tmpfs-logrotate.conf",
        "./etc/systemd/system/auditd.service.d/log-directory.conf uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/auditd-log-directory.conf",
        # sonic_debian_extension.j2:747-748 masks the smart-switch netdevs;
        # systemd-sonic-generator turns them on per platform at boot.
        "./etc/systemd/network/bridge-midplane.netdev uid=0 gid=0 type=link link=/dev/null",
        "./etc/systemd/network/dummy-midplane.netdev uid=0 gid=0 type=link link=/dev/null",
        # ifupdown2 postinst's process_udev(): masks the udev rules that would
        # otherwise race with ifupdown2's own interface bring-up.
        "./etc/udev/rules.d/60-bridge-network-interface.rules uid=0 gid=0 type=link link=/dev/null",
        # openssh-server's runit service dir link (runit-provided sv layout).
        "./etc/runit/runsvdir/default/ssh uid=0 gid=0 type=link link=/etc/sv/ssh",
        # fontconfig-config postinst enables these two conf.avail snippets.
        "./etc/fonts/conf.d/10-hinting-slight.conf uid=0 gid=0 type=link link=/usr/share/fontconfig/conf.avail/10-hinting-slight.conf",
        "./etc/fonts/conf.d/70-no-bitmaps-except-emoji.conf uid=0 gid=0 type=link link=/usr/share/fontconfig/conf.avail/70-no-bitmaps-except-emoji.conf",
        "./etc/initramfs-tools/modules uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/initramfs_modules",
        "./etc/initramfs-tools/conf.d/driver-policy uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/driver-policy",
        "./etc/python3/debian_config uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/debian_config",
        "./etc/subuid uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/subuid",
        "./etc/subgid uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/subuid",
        "./etc/hosts.allow uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/hosts.allow",
        "./etc/hosts.deny uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/hosts.deny",
        "./etc/locale.conf uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/locale.conf",
        # base-files postinst: `ln -sf debian /etc/dpkg/origins/default`.
        "./etc/dpkg/origins/default uid=0 gid=0 type=link link=debian",
        # localectl/`update-locale` leave these two as links into the files they
        # actually manage (systemd's locale/keyboard state layout).
        "./etc/default/locale uid=0 gid=0 type=link link=../locale.conf",
        "./etc/vconsole.conf uid=0 gid=0 type=link link=default/keyboard",
        "./etc/locale.gen uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/locale.gen",
        "./etc/modules uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/modules",
        # shadow's postinst-equivalent state files: empty on a fresh install, but
        # PAM's pam_unix opens /etc/security/opasswd for password history and
        # gshadow must exist for `newgrp`/group passwords to work at all.
        "./etc/gshadow uid=0 gid=42 mode=0640 type=file content=$(RULEDIR)/pc/aa_empty",
        "./etc/security/opasswd uid=0 gid=0 mode=0600 type=file content=$(RULEDIR)/pc/aa_empty",
        # tzdata's default: Etc/UTC.
        "./etc/localtime uid=0 gid=0 type=link link=/usr/share/zoneinfo/Etc/UTC",
        # /proc-backed mount table (util-linux ships this as a symlink).
        "./etc/mtab uid=0 gid=0 type=link link=../proc/self/mounts",
        # build_debian.sh: the ssh generator errors out on SONiC hosts and only
        # pollutes syslog, so it is masked.
        "./etc/systemd/system-generators/systemd-ssh-generator uid=0 gid=0 type=link link=/dev/null",
        # `systemctl --global enable` links from gpg-agent / openssh-client.
        "./etc/systemd/user/sockets.target.wants/keyboxd.socket uid=0 gid=0 type=link link=/usr/lib/systemd/user/keyboxd.socket",
        "./etc/systemd/user/sockets.target.wants/ssh-agent.socket uid=0 gid=0 type=link link=/usr/lib/systemd/user/ssh-agent.socket",
        "./etc/sgml/catalog uid=0 gid=0 mode=0777 type=file content=$(RULEDIR)/pc/sgml_catalog",
        "./etc/xml/catalog.old uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/xml_catalog",
        "./etc/xml/xml-core.xml.old uid=0 gid=0 mode=0644 type=file content=$(RULEDIR)/pc/xml_core_catalog",
        # base-files postinst's `install_directory etc/opt 755 root`.
        "./etc/opt uid=0 gid=0 mode=0755 type=dir",
    ],
    visibility = ["//visibility:public"],
)

