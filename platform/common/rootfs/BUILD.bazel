# -----------------------------------------------------------------------------
# Host content that Make produces by jinja-rendering build templates. The 27
# container control scripts, the 32 build-time systemd units and constants.yml
# are rendered here from those same templates (see container_ctl.bzl /
# service_units.bzl); what remains under rendered/ is snapshotted from the Make
# fsroot-vs baseline:
#
#   init_cfg.json, sonic_version.yml, bmc_config.json, packages.json
#       still template-backed, but their context is build metadata (git SHA,
#       build date, builder identity) or the ~20 INCLUDE_* feature flags.
#   dhcp_relay.service, macsec.service, macsec@.service
#       NOT build templates: sonic-package-manager generates these on the device
#       from sonic.service.j2 at install time ("DO NOT EDIT!" banner).
#   sources.list, dhclient.conf, 00-sonic.conf, asic_config_checksum,
#   union-mount, arista-convertfs
#       effectively static for this platform.
#
# default_users.json is NOT here (root-only in fsroot; version_layer builds it).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# The 27 container control scripts, rendered from
# files/build_templates/docker_image_ctl.j2 the way slave.mk:1842 does (one `j2`
# run per container with docker_container_name / docker_image_name /
# docker_image_run_opt exported). Per-container values live in container_ctl.bzl.
# -----------------------------------------------------------------------------
[
    genrule(
        name = "ctl_" + name.replace("-", "_").replace(".", "_"),
        srcs = ["//files/build_templates:docker_image_ctl.j2"],
        outs = ["ctl/" + name + ".sh"],
        cmd = ("$(execpath @sonic_build_infra//jinja2:render) " +
               "$(execpath //files/build_templates:docker_image_ctl.j2) $@ " +
               "docker_container_name=" + container + " " +
               "docker_image_name=" + image + " " +
               "sonic_asic_platform=" + SONIC_ASIC_PLATFORM + " " +
               " ".join([
                   k + "=" + v
                   for k, v in COMMON_CTL_VARS.items()
               ]) + " " +
               "docker_image_run_opt=" + repr(run_opt)),
        tools = ["@sonic_build_infra//jinja2:render"],
    )
    for name, (container, image, run_opt) in CONTAINER_CTL.items()
]


# -----------------------------------------------------------------------------
# The 35 systemd units, rendered from their .j2 templates the way
# slave.mk:1815-1838 does. Template/variable mapping is in service_units.bzl.
# -----------------------------------------------------------------------------
[
    genrule(
        name = "svc_" + unit.replace("@", "at").replace(".", "_").replace("-", "_"),
        srcs = [template],
        outs = ["svc/" + unit],
        cmd = ("$(execpath @sonic_build_infra//jinja2:render) " +
               "$(execpath " + template + ") $@ " +
               "docker_container_name=" + container + " " +
               "multi_instance=" + multi_instance + " " +
               "sonic_asic_platform=" + SONIC_ASIC_PLATFORM + " " +
               "sonicadmin_user=" + SONICADMIN_USER),
        tools = ["@sonic_build_infra//jinja2:render"],
    )
    for unit, (template, container, multi_instance) in SERVICE_UNITS.items()
]


# rules/config: ENABLE_FRR_SNMP_AGENT ?= y (slave.mk:1805 exports it).
genrule(
    name = "cfg_constants_yml",
    srcs = ["//files/build_templates:constants.yml.j2"],
    outs = ["cfg/constants.yml"],
    cmd = ("$(execpath @sonic_build_infra//jinja2:render) " +
           "$(execpath //files/build_templates:constants.yml.j2) $@ " +
           "ENABLE_FRR_SNMP_AGENT=y"),
    tools = ["@sonic_build_infra//jinja2:render"],
)


# init_cfg.json.j2, driven by the INCLUDE_*/ENABLE_* flags in init_cfg_flags.bzl.
genrule(
    name = "cfg_init_cfg_json",
    srcs = ["//files/build_templates:init_cfg.json.j2"],
    outs = ["cfg/init_cfg.json"],
    cmd = ("$(execpath @sonic_build_infra//jinja2:render) " +
           "$(execpath //files/build_templates:init_cfg.json.j2) $@ " +
           "sonic_asic_platform=" + SONIC_ASIC_PLATFORM + " " +
           # slave.mk:1857-1863 builds $(SERVICES): a container with only a
           # per_namespace template (_TEMPLATE set, _GLOBAL unset) contributes
           # ONLY <c>@.service, which is what makes has_global_scope false for
           # bgp/swss/syncd/teamd/gbsyncd. INSTALLER_SERVICES encodes that.
           "installer_services=" + repr(" ".join(INSTALLER_SERVICES)) + " " +
           " ".join([
               k + "=" + v
               for k, v in INIT_CFG_FLAGS.items()
           ])),
    tools = ["@sonic_build_infra//jinja2:render"],
)

# sonic-package-manager's ServiceCreator renders service_mgmt.sh.j2 into
# /usr/local/bin/<service>.sh for each installed package. Only dhcp_relay and
# macsec end up with one in Make's image (the other 25 containers get the static
# files/scripts/<name>.sh instead), so those two are reproduced here from the
# same template and the same manifest values. `source` is the path the comment
# header records, i.e. where the template lives in the booted image.
[
    genrule(
        name = "spm_mgmt_" + svc,
        srcs = ["@sonic-utilities//:sonic-utilities-data/templates/service_mgmt.sh.j2"],
        outs = ["spm_mgmt/" + svc + ".sh"],
        cmd = ("set -euo pipefail; C=$(RULEDIR)/spm_mgmt_ctx_" + svc + ".json; " +
               "mkdir -p $$(dirname $$C); " +
               "printf '%s' '{\"manifest\": {\"service\": {\"name\": \"" + svc +
               "\", \"dependent\": [], \"post-start-action\": null, " +
               "\"pre-shutdown-action\": null}}, " +
               "\"multi_instance_services\": [], " +
               "\"source\": \"/usr/share/sonic/templates/service_mgmt.sh.j2\"}' > $$C; " +
               "$(execpath @sonic_build_infra//jinja2:render) --context-json $$C " +
               "$(execpath @sonic-utilities//:sonic-utilities-data/templates/service_mgmt.sh.j2) $@"),
        tools = ["@sonic_build_infra//jinja2:render"],
    )
    for svc in [
        "dhcp_relay",
        "macsec",
    ]
]

