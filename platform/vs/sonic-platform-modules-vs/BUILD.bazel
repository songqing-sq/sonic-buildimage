load("@sonic_build_infra//sonic_deb:sonic_deb.bzl", "sonic_deb")

package(default_visibility = ["//visibility:public"])

VERSION = "1.0"

# =============================================================================
# sonic-platform-vs — the vs platform's sonic_platform Python API.
#
# The legacy build (platform/vs/platform-modules-vs.mk) runs
# dpkg-buildpackage with `dh --with python3 --buildsystem=pybuild` over
# setup.py, which installs the `sonic_platform` package into
# /usr/lib/python3/dist-packages/. Here the same three modules are placed
# directly — pybuild adds no code generation, only the dist-packages layout
# (byte-compiled .pyc are generated at install time by the python3 triggers,
# not shipped by the Bazel deb).
#
# Make ships this deb INSIDE platform.tar.gz (installed at first boot by
# install.sh), not into the host rootfs, so //platform/vs/rootfs:platform_tar
# consumes the .deb file itself rather than its data tar.
# =============================================================================
sonic_deb(
    name = "sonic-platform-vs_{}.deb".format(VERSION),
    architecture = "amd64",
    content = {
        "/usr/lib/python3/dist-packages/sonic_platform:sonic_platform:0644": [
            "sonic_platform/__init__.py",
            "sonic_platform/chassis.py",
            "sonic_platform/platform.py",
        ],
    },
    depends = ["python3"],
    description = "Sonic VS platform Module",
    maintainer = "Deepak Singhal <deepsinghal@microsoft.com>",
    package = "sonic-platform-vs",
    priority = "extra",
    section = "main",
    version = VERSION,
)
