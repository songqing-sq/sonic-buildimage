load("@sonic_build_infra//config:arch.bzl", "DEBIAN_ARCH")
load("@sonic_build_infra//onie_installer:image.bzl", "sonic_onie_image")
load("//platform/vs:docker_set.bzl", "VS_DOCKERS")

# The Bazel-assembled sonic-vs.bin ONIE installer (Phase 5 of the vs.bin
# migration). Content baseline = the Make-built target/sonic-vs.bin
# (machine=vs, platform=x86_64-vs-r0, ONIE_IMAGE_PART_SIZE=32768 from
# platform/vs/onie.mk defaults, VAR_LOG_SIZE=4096).
sonic_onie_image(
    name = "sonic-vs-bin",
    arch = DEBIAN_ARCH,
    boot_files = "//platform/vs/kernel:boot_tree",
    dockers = VS_DOCKERS,
    image_version = "bazel-dev",
    initrd = "//platform/vs/rootfs:initrd",
    install_sh_template = "//installer:install.sh",
    # Static installer/ content, plus the two pieces build_image.sh generates.
    # platforms_asic is load-bearing: install.sh greps it with no existence
    # guard, so without it a real ONIE install stops at the "different ASIC
    # type" prompt.
    installer_files = [
        "//installer:installer_files",
        "//installer:platforms_asic_file",
    ],
    installer_tar = "//installer:platforms_dir",
    # Shipped as installer/platform.conf. Empty for vs (no platform-specific
    # installer overrides), but install.sh reads it, so the file must exist.
    platform_conf = "//platform/vs:platform.conf",
    machine = "vs",
    onie_conf = "//:onie-image.conf",
    onie_image_part_size = "32768",
    platform = "x86_64-vs-r0",
    platform_tar = "//platform/vs/rootfs:platform_tar",
    rootfs_layers = [
        # MUST stay first: lays down /var/run -> /run before any deb layer can
        # materialise /var/run as a real directory.
        "//platform/common/rootfs:varrun_layer",
        "//platform/common/rootfs:base_layer",
        "//platform/common/rootfs:docker_engine_layer",
        "//platform/common/rootfs:dpkg_info_layer",
        "//platform/common/rootfs:sonic_dpkg_info_files",
        "//platform/common/rootfs:sonic_debs_layer",
        "//platform/common/rootfs:sonic_wheels_layer",
        "//platform/common/rootfs:passwd",
        "//platform/common/rootfs:group",
        "//platform/common/rootfs:shadow_layer",
        "//platform/common/rootfs:host_config_layer",
        "//platform/common/rootfs:pam_layer",
        "//platform/common/rootfs:base_postinst_layer",
        "//platform/common/rootfs:postinst_conf_layer",
        "//platform/common/rootfs:static_layer",
        "//platform/common/rootfs:alternatives_layer",
        "//platform/common/rootfs:rcd_links_layer",
        "//platform/common/rootfs:ca_certificates_layer",
        "//platform/common/rootfs:ucf_layer",
        "//platform/common/rootfs:cli_plugins_layer",
        "//platform/common/rootfs:rendered_layer",
        "//platform/common/rootfs:version_layer",
        "//platform/common/rootfs:systemd_enable_layer",
        "//platform/common/rootfs:dsh_state_layer",
        "//platform/common/rootfs:dirs_layer",
        "//platform/common/rootfs:dev_layer",
        "//platform/common/rootfs:home_layer",
        "//platform/common/rootfs:kernel_modules_layer",
        "//platform/common/rootfs:generated_services_layer",
    ],
    sharch_body = "//installer:sharch_body.sh",
    var_log_file_size = "4096",
    visibility = ["//visibility:public"],
)

# dash-engine.service: host-side unit copied by sonic_debian_extension.j2.
exports_files(
    [
        "dash-engine.service",
        # Empty for vs, but onie-mk-demo.sh copies it in as
        # installer/platform.conf and install.sh sources it.
        "platform.conf",
    ],
    visibility = ["//visibility:public"],
)
