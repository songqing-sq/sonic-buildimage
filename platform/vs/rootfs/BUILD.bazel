# platform/vs/rootfs — boot artifacts for the Bazel sonic-vs.bin (Phase 3).
#
# Ground truth (Make): target/sonic-vs.bin payload = boot/{vmlinuz,initrd.img,
# System.map,config}-6.12.41+deb13-sonic-amd64 + platform.tar.gz{firsttime,
# x86_64-kvm_x86_64-r0/ -> common/sonic-platform-vs deb, grub/*.deb}.
# fsroot-vs /etc/initramfs-tools: MODULES=most, the SONiC hooks and the
# union-mount/varlog/swi2bin + fsck-rootfs/... boot scripts.
#
# The initrd is built with the STRUCTURAL sonic_rules/initramfs rule (hermetic
# cpio assembly: initramfs-tools framework + static busybox + userspace apt
# closure + MODULES=most kernel-module closure via sealed depmod). The
# initramfs_real (unmodified mkinitramfs under unshare+chroot) variant cannot
# run on hosts with unprivileged userns disabled (this build host). Known
# deviation from Make: COMPRESS=gzip instead of zstd (kernel has both
# CONFIG_RD_GZIP/ZSTD; boot-equivalent).
#
# NOTE: sonic-platform-vs is NOT installed in fsroot — Make ships it inside
# platform.tar.gz and installs it at first boot; sonic-device-data ships via
# //platform/common/rootfs:sonic_debs_layer.

load("@sonic_build_infra//initramfs:defs.bzl", "initramfs")
load("@tar.bzl", "tar")

package(default_visibility = ["//visibility:public"])

KVERSION = "6.12.41+deb13-sonic-amd64"

# Static busybox binary for the initrd shell (exec'd at build time to list
# applets, so it must be static). trixie busybox-static installs
# ./usr/bin/busybox (merged-usr).
genrule(
    name = "busybox_static",
    srcs = ["@trixie//busybox-static:data"],
    outs = ["busybox"],
    cmd = "tar -xOf $$(echo $(locations @trixie//busybox-static:data) | tr ' ' '\\n' | head -1) ./usr/bin/busybox > $@ && chmod +x $@",
)

# Boot userspace closure: the binaries the SONiC init-premount/init-bottom
# scripts and (skipped) hooks would need at runtime — e2fsprogs (mke2fs/
# e2fsck/resize2fs), acl (setfacl), util-linux (losetup/blkid), mount
# (mount/umount — a separate package from util-linux; busybox's applet cannot
# mount the ext4 root), kmod (modprobe), zstd (pzstd for docker_inram), file.
# Each @trixie//<pkg> pulls its shared-lib dep closure.
_USERSPACE = [
    "@trixie//e2fsprogs",
    "@trixie//acl",
    "@trixie//util-linux",
    "@trixie//mount",
    "@trixie//kmod",
    "@trixie//zstd",
    "@trixie//file",
    "@trixie//libmagic1t64",
    "@trixie//libmagic-mgc",
]

initramfs(
    name = "initrd",
    busybox = ":busybox_static",
    depmod = "@sonic_build_infra//kernel_host_tools:depmod",
    initramfs_tools_data = "@initramfs-tools//:initramfs-tools-core_0.142_all.deb_data",
    kversion = KVERSION,
    modules = [
        # files/initramfs-tools/modules (build_debian.sh appends to
        # /etc/initramfs-tools/modules) — the SONiC boot-critical set.
        "squashfs",
        "overlay",
        "vfat",
        "nls_ascii",
        "nls_cp437",
        "nls_utf8",
        "nvme",
        "zstd",
        "efivarfs",
        # loop/virtio for the vs KVM boot path (loop-mounted squashfs root).
        "loop",
        "virtio_blk",
        "virtio_pci",
        "virtio_net",
        "ext4",
        # ext4 asks the crypto API for "crc32c" by alias when mounting, which is
        # a runtime request rather than a modules.dep edge, so the dep-closure
        # walk cannot discover it. Without these the root mount dies with
        # "EXT4-fs (vda3): Cannot load crc32c driver."
        "crc32c_generic",
        "libcrc32c",
    ],
    modules_tree = "//platform/vs/kernel:modules_install",
    out = "initrd.img-" + KVERSION,
    scripts = {
        # fsroot-vs /etc/initramfs-tools truth -> cpio scripts/ layout.
        "//files/initramfs-tools:rendered_union_mount": "scripts/init-bottom/union-mount",
        "//files/initramfs-tools:varlog": "scripts/init-bottom/varlog",
        "//files/initramfs-tools:swi2bin": "scripts/init-bottom/swi2bin",
        "//files/initramfs-tools:fsck-rootfs": "scripts/init-premount/fsck-rootfs",
        "//files/initramfs-tools:resize-rootfs": "scripts/init-premount/resize-rootfs",
        "//files/initramfs-tools:ssd-upgrade": "scripts/init-premount/ssd-upgrade",
        "//files/initramfs-tools:rendered_arista_convertfs": "scripts/init-premount/arista-convertfs",
        "//files/initramfs-tools:arista-hook": "scripts/init-premount/arista-hook",
        "//files/initramfs-tools:arista-net": "scripts/init-premount/arista-net",
        "//files/initramfs-tools:arista-wait-blockdev": "scripts/init-premount/arista-wait-blockdev",
    },
    tags = ["manual"],
    userspace_layers = _USERSPACE,
)

# -----------------------------------------------------------------------------
# platform.tar.gz — mirror of the Make payload member:
#   ./firsttime                                (empty marker)
#   ./common/sonic-platform-vs_1.0_amd64.deb   (the platform deb)
#   ./x86_64-kvm_x86_64-r0/... -> symlink into common/
#   ./grub/grub-pc-bin*.deb grub-efi-amd64-bin*.deb
#
# All three debs come from hermetic sources: sonic-platform-vs is built by
# //platform/vs/sonic-platform-modules-vs (sonic_deb over its setup.py
# modules), and the grub bin debs are the pinned Debian snapshot .deb files
# (installed by install.sh at first boot, so the payload carries the .deb
# itself rather than its unpacked contents).
# -----------------------------------------------------------------------------
tar(
    name = "platform_tar",
    srcs = [
        ":firsttime",
        "//platform/vs/sonic-platform-modules-vs:sonic-platform-vs_1.0.deb",
        "@grub_pc_bin_deb//file",
        "@grub_efi_amd64_bin_deb//file",
    ],
    compress = "gzip",
    mtree = [
        "./firsttime uid=0 gid=0 mode=0644 type=file content=$(location :firsttime)",
        "./common/sonic-platform-vs_1.0_amd64.deb uid=0 gid=0 mode=0644 type=file content=$(location //platform/vs/sonic-platform-modules-vs:sonic-platform-vs_1.0.deb)",
        "./x86_64-kvm_x86_64-r0/sonic-platform-vs_1.0_amd64.deb uid=0 gid=0 type=link link=../common/sonic-platform-vs_1.0_amd64.deb",
        "./grub/grub-pc-bin_2.12-9+deb13u1_amd64.deb uid=0 gid=0 mode=0644 type=file content=$(location @grub_pc_bin_deb//file)",
        "./grub/grub-efi-amd64-bin_2.12-9+deb13u1_amd64.deb uid=0 gid=0 mode=0644 type=file content=$(location @grub_efi_amd64_bin_deb//file)",
    ],
    out = "platform.tar.gz",
)

# The empty first-boot marker install.sh looks for.
genrule(
    name = "firsttime",
    outs = ["firsttime.marker"],
    cmd = ": > $@",
)
