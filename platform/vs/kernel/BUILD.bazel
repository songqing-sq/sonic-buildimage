# Boot artifacts for the Bazel sonic-vs image, forwarded from the hermetic
# kernel build.
#
# @sonic_linux_kernel builds the SONiC kernel from the sha256-pinned Debian
# source tarballs plus this tree's 254-patch series (see
# src/sonic-linux-kernel), so nothing here reads target/debs — the Make output
# tree is not an input to the Bazel image.
#
# This package only reshapes those artifacts into the layouts the image
# pipeline wants:
#   :boot_tree      boot/-rooted TREE artifact  -> installer_payload boot_files
#   :kernel_config  /boot/config-<kver>          -> initramfs (compressor check)
#   :modules_install lib/modules/<kver>/...      -> rootfs modules layer
#   :modules_flat   contents of lib/modules/<kver>/ -> initramfs modules_tree

load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load(":flatten_modules_tree.bzl", "flatten_modules_tree")

package(default_visibility = ["//visibility:public"])

KVERSION = "6.12.41+deb13-sonic-amd64"

# --- Boot files --------------------------------------------------------------
# The kernel build emits bzImage / System.map / .config under its own names;
# the payload expects them at boot/<name>-<kver>.
genrule(
    name = "boot_files_named",
    srcs = [
        "@sonic_linux_kernel//:kernel_amd64_image",
        "@sonic_linux_kernel//:kernel_amd64_system_map",
        "@sonic_linux_kernel//:kernel_amd64_config_file",
    ],
    outs = [
        "boot/vmlinuz-" + KVERSION,
        "boot/System.map-" + KVERSION,
        "boot/config-" + KVERSION,
    ],
    cmd = ("set -e; " +
           "cp $(location @sonic_linux_kernel//:kernel_amd64_image) $(location boot/vmlinuz-{k}); " +
           "cp $(location @sonic_linux_kernel//:kernel_amd64_system_map) $(location boot/System.map-{k}); " +
           "cp $(location @sonic_linux_kernel//:kernel_amd64_config_file) $(location boot/config-{k})").format(k = KVERSION),
)

filegroup(
    name = "vmlinuz",
    srcs = ["boot/vmlinuz-" + KVERSION],
)

filegroup(
    name = "system_map",
    srcs = ["boot/System.map-" + KVERSION],
)

filegroup(
    name = "kernel_config",
    srcs = ["boot/config-" + KVERSION],
)

filegroup(
    name = "boot_files",
    srcs = [
        "boot/vmlinuz-" + KVERSION,
        "boot/System.map-" + KVERSION,
        "boot/config-" + KVERSION,
    ],
)

# boot/-rooted TREE artifact — the shape installer_payload's `boot_files` attr
# consumes (`cp -RL <tree>/.`).
copy_to_directory(
    name = "boot_tree",
    srcs = [":boot_files"],
    root_paths = ["platform/vs/kernel"],
)

# --- Modules -----------------------------------------------------------------
# The kernel build's modules_install tree is already lib/modules/<kver>/...,
# which is what the rootfs layer wants.
alias(
    name = "modules_install",
    actual = "@sonic_linux_kernel//:kernel_amd64_modules_install",
)

# The initramfs rule wants a tree whose ROOT is the contents of
# lib/modules/<kver>/ (its builder does `cp -RL "$MODULES_TREE/."`), so strip
# the lib/modules/<kver> prefix off the kernel build's tree.
flatten_modules_tree(
    name = "modules_flat",
    kversion = KVERSION,
    modules_tree = "@sonic_linux_kernel//:kernel_amd64_modules_install",
)
