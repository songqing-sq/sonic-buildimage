module(
    name = "syslog-counter",
    version = "1.0.0",
)

bazel_dep(name = "rules_rust", version = "0.61.0")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "sonic-build-infra", version = "0.0.0", repo_name = "sonic_build_infra")
bazel_dep(name = "sonic-swss-common", version = "1.0.0")
bazel_dep(name = "rules_distroless", version = "0.0.0", repo_name = "rules_deb")

# Cargo.toml lists swss-common as a `path = "../sonic-swss-common/crates/swss-common"`
# dep so plain `cargo build` still works. crate_universe cannot cross module
# boundaries for path deps, so in the Bazel graph it is substituted with
# @sonic-swss-common//crates/swss-common:swss_common (see BUILD.bazel).
#
# from_specs mode (rather than from_cargo) is used for exactly that reason: it
# lets us enumerate only the crates.io deps and skip the path dep, and it does
# not require Cargo.lock to stay in sync.
crate = use_extension("@rules_rust//crate_universe:extension.bzl", "crate")
crate.spec(
    package = "env_logger",
    version = "0.11.8",
)
crate.spec(
    package = "log",
    version = "0.4.27",
)
crate.from_specs(name = "syslog_counter_crates")
use_repo(crate, "syslog_counter_crates")

# Test-only runtime closure. A sandboxed test has no installed debs at all, so
# every library the test binary loads has to reach the runfiles. In production
# these arrive via libswsscommon's deb Depends, which put them in the standard
# multiarch dir. swsscommon declares them in its own isolated pool, invisible
# from here, hence the duplication. libc6 also supplies the ld-linux the wrapper
# runs the binary under, so the loader and libc stay from one glibc package.
# amd64 only -- tests run on the exec platform.
apt = use_extension("@rules_deb//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "syslog_counter_test_deps",
    packages = [
        "libboost-serialization1.83.0:amd64",
        "libc6:amd64",
        "libgcc-s1:amd64",
        "libhiredis1.1.0:amd64",
        "liblua5.1-0:amd64",
        "libpcre2-8-0:amd64",
        "libpcre2-16-0:amd64",
        "libpcre2-32-0:amd64",
        "libpcre2-posix3:amd64",
        "libstdc++6:amd64",
        "libuuid1:amd64",
        "libxxhash0:amd64",
        "libzmq5:amd64",
        "zlib1g:amd64",
    ],
    suites = ["trixie", "trixie-updates", "trixie-security"],
)
use_repo(apt, "syslog_counter_test_deps")
