# Macros config.h.in already spells as `#define`, either bare or with an
# upstream placeholder value; configure rewrites these in place.
CONFIG_REDEFINES = {
    "COND_REGEXP": "1",
    "COPROCESS_SUPPORT": "1",
    "DEFAULT_MAIL_DIRECTORY": "\"/var/mail\"",
}

# configure's only substitution in pathnames.h.in:
#   DEBUGGER_START_FILE='${datadir}/bashdb/bashdb-main.inc'
# with datadir = $prefix/share and debian/rules passing --prefix=/usr. Verified
# against the string embedded in Make's bash_5.2.37-2_amd64.deb.
DEBUGGER_START_FILE = "/usr/share/bashdb/bashdb-main.inc"

# Makefile's `Version = 5.2` / `RELSTATUS = release`, consumed by
# support/mkversion.sh.
VERSION_BASE = "5.2"

RELSTATUS = "release"

# builtins/psize.sh writes pipesize.h by actually filling a pipe on the build
# machine — a host probe with no place in a hermetic build. 65536 is Linux's
# default pipe buffer (16 pages), and matches what Make's build measured.
PIPESIZE = 65536

# Makefile.in's SYSTEM_FLAGS + LOCALE_DEFS, which configure fills from the host
# triple and --prefix. conftypes.h requires all four CONF_* macros.
# CONF_MACHTYPE / LOCALEDIR verified against the strings in Make's
# bash_5.2.37-2_amd64.deb (x86_64-pc-linux-gnu, /usr/share/locale).
SYSTEM_FLAGS = {
    "PROGRAM": "bash",
    "CONF_HOSTTYPE": "x86_64",
    "CONF_OSTYPE": "linux-gnu",
    "CONF_MACHTYPE": "x86_64-pc-linux-gnu",
    "CONF_VENDOR": "pc",
    "LOCALEDIR": "/usr/share/locale",
    "PACKAGE": "bash",
}
