# usr/sbin: grub-mkconfig. usr/bin: grub-kbdcomp.
# grub2-common's usr/sbin: grub-set-default, grub-reboot.
[
    genrule(
        name = "gen_" + name.replace("-", "_"),
        srcs = ["@sonic_build_infra//grub:src/util/" + name + ".in"],
        outs = ["scripts/" + name],
        cmd = script_subst_cmd() + " $< > $@",
    )
    for name in [
        "grub-mkconfig",
        "grub-kbdcomp",
        "grub-set-default",
        "grub-reboot",
        "grub-mkconfig_lib",
    ]
]

# etc/grub.d/*. Upstream ships one .in per generator; Debian adds
# 05_debian_theme and drops the non-Linux ones (10_hurd, 10_kfreebsd, ...) via
# grub-common.install.in listing only etc/grub.d.
[
    genrule(
        name = "gen_grubd_" + name,
        srcs = ["@sonic_build_infra//grub:src/util/grub.d/" + name + ".in"],
        outs = ["grub.d/" + name],
        cmd = script_subst_cmd() + " $< > $@",
    )
    for name in [
        "00_header",
        "10_linux",
        "20_linux_xen",
        "30_os-prober",
        "30_uefi-firmware",
        "40_custom",
        "41_custom",
    ]
]


