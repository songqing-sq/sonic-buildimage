# ---------------------------------------------------------------------------
# grub2-common
# ---------------------------------------------------------------------------

# debian/default/grub is also a template.
genrule(
    name = "gen_default_grub",
    srcs = ["@sonic_build_infra//grub:src/debian/default/grub"],
    outs = ["default/grub"],
    cmd = script_subst_cmd() + " $< > $@",
)

genrule(
    name = "grub2_common_data",
    srcs = [
        ":bin_grub_install",
        ":gen_grub_reboot",
        ":gen_grub_set_default",
        "@sonic_build_infra//grub:src/debian/update-grub",
        "@sonic_build_infra//grub:src/debian/kernel/zz-update-grub",
        ":gen_default_grub",
        "@sonic_build_infra//grub:src/debian/default/grub.md5sum",
    ],
    outs = ["grub2_common_data.tar"],
    cmd = ("set -e; " +
           "R=$(RULEDIR)/_g2c; " +
           "mkdir -p $$R/usr/sbin $$R/usr/share/grub/default " +
           "  $$R/etc/kernel/postinst.d $$R/etc/kernel/postrm.d " +
           "  $$R/usr/share/bash-completion/completions; " +
           "install -m0755 $(location :bin_grub_install) $$R/usr/sbin/grub-install; " +
           "install -m0755 $(location :gen_grub_reboot) $$R/usr/sbin/grub-reboot; " +
           "install -m0755 $(location :gen_grub_set_default) " +
           "  $$R/usr/sbin/grub-set-default; " +
           "install -m0755 $(location @sonic_build_infra//grub:src/debian/update-grub) " +
           "  $$R/usr/sbin/update-grub; " +
           # debian/rules ships update-grub2 as a symlink to update-grub.
           "ln -s update-grub $$R/usr/sbin/update-grub2; " +
           # The same hook script goes in both kernel postinst.d and postrm.d.
           "install -m0755 " +
           "  $(location @sonic_build_infra//grub:src/debian/kernel/zz-update-grub) " +
           "  $$R/etc/kernel/postinst.d/zz-update-grub; " +
           "install -m0755 " +
           "  $(location @sonic_build_infra//grub:src/debian/kernel/zz-update-grub) " +
           "  $$R/etc/kernel/postrm.d/zz-update-grub; " +
           "install -m0644 $(location :gen_default_grub) " +
           "  $$R/usr/share/grub/default/grub; " +
           "install -m0644 " +
           "  $(location @sonic_build_infra//grub:src/debian/default/grub.md5sum) " +
           "  $$R/usr/share/grub/default/grub.md5sum; " +
           # These three complete via grub-common's shared completion script.
           "for p in grub-install grub-reboot grub-set-default; do " +
           "  ln -s grub $$R/usr/share/bash-completion/completions/$$p; " +
           "done; " +
           "tar -cf $@ --owner=0 --group=0 --numeric-owner -C $$R ."),
)

sonic_deb(
    name = "grub2-common_{}.deb".format(VERSION),
    package = "grub2-common",
    version = VERSION,
    content = {},
    data = ":grub2_common_data",
    depends = [
        "grub-common (= {})".format(VERSION),
        "libc6 (>= 2.38)",
        "libdevmapper1.02.1 (>= 2:1.02.36)",
        "libefiboot1t64 (>= 38)",
        "libefivar1t64 (>= 38)",
        "liblzma5 (>= 5.1.1alpha+20120614)",
    ],
    maintainer = "GRUB Maintainers <pkg-grub-devel@alioth-lists.debian.net>",
    description = "GRand Unified Bootloader (common files for version 2)\n This package contains common files shared by the distinct flavours of GRUB 2.",
    homepage = "https://www.gnu.org/software/grub/",
    section = "admin",
    priority = "optional",
    gen_dbg = True,
)
