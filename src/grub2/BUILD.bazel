           "install -m0755 $(location :bin_grub_macbless) $$R/usr/sbin/grub-macbless; " +
           "install -m0755 $(location :bin_grub_mkdevicemap) $$R/usr/sbin/grub-mkdevicemap; " +
           "install -m0755 $(location :bin_grub_probe) $$R/usr/sbin/grub-probe; " +
           "install -m0755 $(location :gen_grub_kbdcomp) $$R/usr/bin/grub-kbdcomp; " +
           "install -m0755 $(location :gen_grub_mkconfig) $$R/usr/sbin/grub-mkconfig; " +
           "install -m0644 $(location :gen_grub_mkconfig_lib) " +
           "  $$R/usr/share/grub/grub-mkconfig_lib; " +
           "for f in ascii.h ascii.pf2 euro.pf2 unicode.pf2 widthspec.h; do " +
           "  install -m0644 $(RULEDIR)/fonts/$$f $$R/usr/share/grub/$$f; " +
           "done; " +
           "install -m0755 $(location :gen_grubd_00_header) $$R/etc/grub.d/00_header; " +
           "install -m0755 $(location :gen_grubd_10_linux) $$R/etc/grub.d/10_linux; " +
           "install -m0755 $(location :gen_grubd_20_linux_xen) $$R/etc/grub.d/20_linux_xen; " +
           "install -m0755 $(location :gen_grubd_30_os-prober) $$R/etc/grub.d/30_os-prober; " +
           "install -m0755 $(location :gen_grubd_30_uefi-firmware) $$R/etc/grub.d/30_uefi-firmware; " +
           "install -m0755 $(location :gen_grubd_40_custom) $$R/etc/grub.d/40_custom; " +
           "install -m0755 $(location :gen_grubd_41_custom) $$R/etc/grub.d/41_custom; " +
           "install -m0755 $(location @sonic_build_infra//grub:src/debian/grub.d/05_debian_theme) " +
           "  $$R/etc/grub.d/05_debian_theme; " +
           "install -m0644 $(location @sonic_build_infra//grub:src/util/grub.d/README) " +
           "  $$R/etc/grub.d/README; " +
           "install -m0644 $(location @sonic_build_infra//grub:src/debian/init-select.cfg) " +
           "  $$R/etc/default/grub.d/init-select.cfg; " +
           "install -m0644 $(location @sonic_build_infra//grub:src/debian/apport/source_grub2.py) " +
           "  $$R/usr/share/apport/package-hooks/source_grub2.py; " +
           "install -m0644 $(location :gen_completion) " +
           "  $$R/usr/share/bash-completion/completions/grub; " +
           # debian/rules creates these as symlinks, which the content map
           # cannot express.
           "for p in grub-editenv grub-mkconfig grub-mkfont grub-mkimage " +
           "         grub-mkpasswd-pbkdf2 grub-mkrescue grub-probe " +
           "         grub-script-check; do " +
           "  ln -s grub $$R/usr/share/bash-completion/completions/$$p; " +
           "done; " +
           "ln -s ../../share/grub/grub-mkconfig_lib " +
           "  $$R/usr/lib/grub/grub-mkconfig_lib; " +
           "tar -cf $@ --owner=0 --group=0 --numeric-owner -C $$R ."),
)

