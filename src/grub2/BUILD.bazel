VERSION = "2.06-13+deb13u1"

# KNOWN DIVERGENCE: `grub-probe --version` prints "2.06" where Make's prints
# "2.06-13+deb13u1". debian/rules passes the Debian version as PACKAGE_VERSION,
# but //sonic_rules/grub's generated config.h hardcodes the upstream "2.06" and
# its include directory arrives transitively through every grub library here, so
# it cannot be shadowed from this package. Cosmetic: only the --version banner
# differs, and closing it means making the version a parameter of
# //sonic_rules/grub's config.h, which its own host tools share.

# =============================================================================
# The GRUB 2.06 userspace utilities that grub-common and grub2-common ship.
#
# The four libraries they link (libgrubmods / libgrubgcry / libgrubkern /
# gnulib) are already built by //sonic_rules/grub for its own host tools, so
# GRUB_ALL_LIB_DEPS is reused rather than compiling GRUB twice.
#
# Per-program source lists are transcribed from upstream Makefile.util.def.
# =============================================================================

# util/config.c and grub-core/osdep/config.c share a basename, so the osdep one
# is compiled separately (same split //sonic_rules/grub already needs).

