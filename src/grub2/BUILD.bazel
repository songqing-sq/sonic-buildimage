# ---------------------------------------------------------------------------
# grub-common
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# usr/share/grub/{unicode,ascii,euro}.pf2 + {ascii,widthspec}.h
#
# Makefile.am generates these from FONT_SOURCE with grub-mkfont plus two small
# generators; configure finds FONT_SOURCE by scanning for unifont.pcf in
# /usr/share/fonts/X11/misc and friends (configure.ac:1741), which on the Make
# side is provided by the xfonts-unifont build-dep in debian/control. Here the
# same package supplies it through apt, so nothing is taken from the host.
#
# The commands and codepoint ranges are Makefile.am:114-136
# (UNICODE_ARROWS=0x2190-0x2193, UNICODE_LINES=0x2501-0x251B).
# ---------------------------------------------------------------------------
[
    cc_binary(
        name = "grub_gen_" + n,
        srcs = ["@sonic_build_infra//grub:src/util/grub-gen-" + n + ".c"],
        copts = GRUB_COMMON_COPTS,
        linkopts = ["-lm"],
        deps = GRUB_ALL_LIB_DEPS + GRUB_COMMON_DEPS + [
            "@grub2_deps//libfreetype-dev:freetype",
            "@grub2_deps//libbrotli-dev:brotlidec",
            "@grub2_deps//libbrotli-dev:brotlicommon",
        ],
    )
    for n in [
        "asciih",
        "widthspec",
    ]
]

# unifont ships gzipped; grub-mkfont needs it uncompressed.
genrule(
    name = "gen_unifont",
    srcs = ["@grub2_deps//xfonts-unifont:data"],
    outs = ["unifont.pcf"],
    cmd = ("set -e; " +
           "U=$(RULEDIR)/_unifont; mkdir -p $$U; " +
           "tar -xzf $(location @grub2_deps//xfonts-unifont:data) -C $$U " +
           "  ./usr/share/fonts/X11/misc/unifont.pcf.gz; " +
           "gzip -dc $$U/usr/share/fonts/X11/misc/unifont.pcf.gz > $@"),
)

# The three tools link the hermetic glibc from _solib_k8, but their PT_INTERP
# still names the host /lib64/ld-linux-x86-64.so.2. When the host glibc differs
# from the hermetic one (e.g. Ubuntu 2.43 vs Debian trixie 2.41) that loader
# segfaults during its own initialization, before any program code runs, so
# neither LD_LIBRARY_PATH nor LD_PRELOAD can help. Launching them through the
# matching hermetic ld.so does: the binaries' RPATH already covers every
# hermetic .so, so it resolves the rest via $ORIGIN on its own.
genrule(
    name = "gen_fonts",
    outs = [
        "fonts/unicode.pf2",
        "fonts/ascii.pf2",
        "fonts/euro.pf2",
        "fonts/ascii.h",
        "fonts/widthspec.h",
    ],
    cmd = ("set -e; " +
           "D=$$(realpath $(RULEDIR))/_hermetic; mkdir -p $$D; " +
           "for t in $(locations :hermetic_runtime_libs); do " +
           "  tar -xzf $$t -C $$D; done; " +
           "P=$$D/usr/lib/x86_64-linux-gnu; " +
           "for so in libfreetype.so.6 libbz2.so.1.0 libpng16.so.16 " +
           "          libz.so.1 libbrotlidec.so.1 libbrotlicommon.so.1 " +
           "          libstdc++.so.6 libgcc_s.so.1; do " +
           "  [ -e $$P/$$so ] || ln -sf \"$$(ls -1 $$P/$$so.* | head -1)\" " +
           "    $$P/$$so; done; " +
           "R=\"$$P/ld-linux-x86-64.so.2 --library-path $$P\"; " +
           "$$R $(location :grub_mkfont) -o $(location fonts/unicode.pf2) " +
           "  $(location :gen_unifont); " +
           "$$R $(location :grub_mkfont) -o $(location fonts/ascii.pf2) " +
           "  $(location :gen_unifont) " +
           "  -r 0x0-0x7f,0x2190-0x2193,0x2501-0x251B; " +
           "$$R $(location :grub_mkfont) -o $(location fonts/euro.pf2) " +
           "  $(location :gen_unifont) " +
           "  -r 0x0-0x4ff,0x1e00-0x1fff,0x2190-0x2193,0x2501-0x251B; " +
           "$$R $(location :grub_gen_asciih) $(location :gen_unifont) " +
           "  $(location fonts/ascii.h); " +
           "$$R $(location :grub_gen_widthspec) $(location :gen_unifont) " +
           "  $(location fonts/widthspec.h)"),
    # NOTE: in `srcs`, not `tools`. A genrule's `tools` are built in the exec
    # configuration, where these come out 93KB instead of 1076KB and segfault —
    # the exec config does not carry this project's sysroot/toolchain setup.
    # Listing them as srcs builds them in the target configuration instead, which
    # is valid here because the build and target platforms are both x86_64 linux.
    srcs = [
        ":gen_unifont",
        ":grub_gen_asciih",
        ":grub_gen_widthspec",
        ":grub_mkfont",
        ":hermetic_runtime_libs",
    ],
)

# Every .so the font tools list as NEEDED. The genrule unpacks these and runs
# the tools under the hermetic ld.so from libc6, because the sandbox stages no
# _solib_k8 for their RPATH to resolve against.
filegroup(
    name = "hermetic_runtime_libs",
    srcs = [
        "@grub2_deps//libbrotli1:data",
        "@grub2_deps//libbz2-1.0:data",
        "@grub2_deps//libc6:data",
        "@grub2_deps//libfreetype6:data",
        "@grub2_deps//libgcc-s1:data",
        "@grub2_deps//libpng16-16t64:data",
        "@grub2_deps//libstdc++6:data",
        "@grub2_deps//zlib1g:data",
    ],
)

