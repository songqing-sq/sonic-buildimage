# Tests packaged in the wheel. Make's setup.py with include_package_data=True
# captures everything under tests/ (Python sources + JSON data files).
TEST_SRCS = glob([
    "tests/**/*.py",
    "tests/**/*.json",
])

# =============================================================================
# Jinja2 renderer. py_venv_binary applies the venv transition so the
# @sonic_yang_models_pip pip dep resolves.
# =============================================================================
py_venv_binary(
    name = "render_yang_template",
    srcs = ["tools/render_yang_template.py"],
    main = "tools/render_yang_template.py",
    venv = "sonic-yang-models",
    deps = ["@sonic_yang_models_pip//jinja2"],
)

# Render each templated yang twice (py and cvl). Outputs are placed under
# gen/yang-models/ and gen/cvlyang-models/ respectively.
[
    genrule(
        name = "render_py_" + f.replace(".yang", ""),
        srcs = ["yang-templates/" + f + ".j2"],
        outs = ["gen/yang-models/" + f],
        cmd = "$(execpath :render_yang_template) " +
              "--template $(execpath yang-templates/" + f + ".j2) " +
              "--yang_model_type py --out $@",
        tools = [":render_yang_template"],
    )
    for f in TEMPLATE_YANG_FILES
]

[
    genrule(
        name = "render_cvl_" + f.replace(".yang", ""),
        srcs = ["yang-templates/" + f + ".j2"],
        outs = ["gen/cvlyang-models/" + f],
        cmd = "$(execpath :render_yang_template) " +
              "--template $(execpath yang-templates/" + f + ".j2) " +
              "--yang_model_type cvl --out $@",
        tools = [":render_yang_template"],
    )
    for f in TEMPLATE_YANG_FILES
]

# Static yang files need to land in BOTH yang-models/ (via the source file
# itself) and cvlyang-models/ (which Make's setup.py builds by shutil.copyfile
# in my_build_py). py_wheel.data_files keys are unique label paths, so we
# generate a second labeled copy for the cvl side. Outputs share the
# gen/cvlyang-models/ directory with the rendered templates (lists are
# disjoint) so :cvlyang_models_files spans exactly one directory -- consumers
# (sonic-mgmt-common codegen) derive the model dir from any one file.
[
    copy_file(
        name = "cvl_copy_" + f.replace(".yang", ""),
        src = "yang-models/" + f,
        out = "gen/cvlyang-models/" + f,
    )
    for f in STATIC_YANG_FILES
]

# Complete cvl-flavored model set (4 rendered + 142 copied = 146), all under
# gen/cvlyang-models/. Replaces the old glob of the Make-generated source-tree
# cvlyang-models/ directory (non-hermetic, stale: it lacked the 4 rendered
# templates, breaking yang_build_tree's sonic-types.yang import).
filegroup(
    name = "cvlyang_models_files",
    srcs = [":gen/cvlyang-models/" + f for f in TEMPLATE_YANG_FILES + STATIC_YANG_FILES],
    visibility = ["//visibility:public"],
)

# =============================================================================
# py_wheel: sonic_yang_models-1.0-py3-none-any.whl
# =============================================================================
_DATA_FILES = {}

[_DATA_FILES.update({":gen/yang-models/" + f: "data/yang-models/" + f}) for f in TEMPLATE_YANG_FILES]
[_DATA_FILES.update({":gen/cvlyang-models/" + f: "data/cvlyang-models/" + f}) for f in TEMPLATE_YANG_FILES]
[_DATA_FILES.update({"yang-models/" + f: "data/yang-models/" + f}) for f in STATIC_YANG_FILES]
[_DATA_FILES.update({":gen/cvlyang-models/" + f: "data/cvlyang-models/" + f}) for f in STATIC_YANG_FILES]

# Fixture data under tests/files, exported for OTHER modules: the
# libyang-python suite in sonic-yang-mgmt reads sample_config_db.json and
# friends through "../sonic-yang-models/tests/files/...".
filegroup(
    name = "tests_files",
    srcs = glob(["tests/files/**"]),
    visibility = ["//visibility:public"],
)

py_library(
    name = "tests_pkg",
    srcs = TEST_SRCS,
    imports = ["."],
)

# Wheel's top_level.txt records top-level importable package names.
# setup.py's find_packages() returns ['tests'], so this file is a single line.
genrule(
    name = "top_level_txt",
    outs = ["top_level.txt"],
    cmd = "echo tests > $@",
)

py_wheel(
    name = "wheel",
    distribution = "sonic_yang_models",
    version = "1.0",
    summary = "Package contains YANG models for sonic.",
    author = "lnos-coders",
    author_email = "lnos-coders@linkedin.com",
    license = "GNU General Public License v3",
    python_requires = ">=2.7, !=3.0.*, !=3.1.*, !=3.2.*, !=3.3.*, !=3.4.*",
    classifiers = [
        "Development Status :: 2 - Pre-Alpha",
        "Intended Audience :: Developers",
        "License :: OSI Approved :: GNU General Public License v3 (GPLv3)",
        "Natural Language :: English",
        "Programming Language :: Python :: 2",
        "Programming Language :: Python :: 2.7",
        "Programming Language :: Python :: 3",
        "Programming Language :: Python :: 3.5",
        "Programming Language :: Python :: 3.6",
        "Programming Language :: Python :: 3.7",
        "Programming Language :: Python :: 3.8",
    ],
    extra_requires = {
        "testing": [
            "pytest",
            "ijson>=3.2.3",
        ],
    },
    description_file = "README.rst",
    extra_distinfo_files = {
        "AUTHORS.rst": "AUTHORS.rst",
        "LICENSE": "LICENSE",
        ":top_level_txt": "top_level.txt",
    },
    data_files = _DATA_FILES,
    strip_path_prefixes = ["src/sonic-yang-models"],
    visibility = ["//visibility:public"],
    deps = [":tests_pkg"],
)

# Tar layer for OCI image composition. Files land at /usr/local/...
# (sys.prefix used by pip3 against Debian system Python). Consumers find them
# via /usr/local/yang-models (see e.g. YANG_MODELS_DIR in sonic-config-engine).
_INSTALL_MTREE = (
    ["./usr/local/yang-models/" + f + " uid=0 gid=0 mode=0644 type=file content=$(location :gen/yang-models/" + f + ")" for f in TEMPLATE_YANG_FILES] +
    ["./usr/local/yang-models/" + f + " uid=0 gid=0 mode=0644 type=file content=$(location yang-models/" + f + ")" for f in STATIC_YANG_FILES] +
    ["./usr/local/cvlyang-models/" + f + " uid=0 gid=0 mode=0644 type=file content=$(location :gen/cvlyang-models/" + f + ")" for f in TEMPLATE_YANG_FILES] +
    ["./usr/local/cvlyang-models/" + f + " uid=0 gid=0 mode=0644 type=file content=$(location :gen/cvlyang-models/" + f + ")" for f in STATIC_YANG_FILES]
)

_INSTALL_SRCS = (
    [":gen/yang-models/" + f for f in TEMPLATE_YANG_FILES] +
    ["yang-models/" + f for f in STATIC_YANG_FILES] +
    [":gen/cvlyang-models/" + f for f in TEMPLATE_YANG_FILES] +
    [":gen/cvlyang-models/" + f for f in STATIC_YANG_FILES]
)

tar(
    name = "install",
    srcs = _INSTALL_SRCS,
    mtree = _INSTALL_MTREE,
    visibility = ["//visibility:public"],
)

# =============================================================================
# yang_models_files — flat filegroup of all py-flavored yang files (142 static
# + 4 template-rendered = 146). Consumers like sonic-swss-common's
# cfg_schema_gen need raw .yang text under one directory.
# =============================================================================
filegroup(
    name = "yang_models_files",
    srcs = [
        ":gen/yang-models/" + f for f in TEMPLATE_YANG_FILES
    ] + [
        "yang-models/" + f for f in STATIC_YANG_FILES
    ],
    visibility = ["//visibility:public"],
)

# =============================================================================
# Unit tests. Bazel equivalent of the Make-side test step in slave.mk's
# SONIC_PYTHON_WHEELS recipe:
#     pip3 install ".[testing]" && pip3 uninstall --yes <self>
#     timeout ... python3 -m pytest        # gate: wheel is built only if green
#
# Only tests/yang_model_pytests/ is wired here. tests/yang_model_tests/ is a
# different harness -- JSON-driven, over sonic-yang-mgmt -- and belongs with that
# package.
#
# conftest.py builds a libyang context from <package root>/yang-models/*.yang,
# walking up two levels from its own __file__, so the models have to be staged at
# exactly that path. Four of the 146 are rendered from templates and land under
# gen/yang-models/, which is why :yang_models_files (covering both roots) is the
# data dep rather than a plain glob.
#
# Fully hermetic: the suite only parses YANG text and validates JSON against it.
# =============================================================================
py_library(
    name = "pytest_lib",
    testonly = True,
    srcs = glob(["tests/yang_model_pytests/*.py"]),
    # conftest.py hardcodes <package root>/yang-models as its single libyang
    # searchdir (it walks up two levels from its own __file__), so every model has
    # to sit there. For the four templated ones that means the SOURCE copies, not
    # the rendered gen/yang-models/ outputs: Bazel will not place a generated file
    # at a path a source file already occupies. Harmless here -- the suite only
    # needs the models to parse and sonic-types.yang to be importable, and the
    # templating only substitutes a py/cvl flavour that these cases never inspect.
    data = glob(["yang-models/*.yang"]),
    imports = ["."],
    deps = [
        "@libyang3-py3//:libyang",
        "@sonic_yang_models_pip//cffi",
        "@sonic_yang_models_pip//pytest",
    ],
)

# libyang's CFFI extension links libyang.so.3 and the pcre2 family. ld.so reads
# LD_LIBRARY_PATH once at process start, so this cannot be done from the pytest
# shim -- it has to be an env entry. The paths are the runfiles dirs the two
# providers stage into, deliberately enumerated rather than discovered: a blanket
# scan of the runfiles tree would also surface the trixie libc.so.6 and kill the
# host interpreter (GLIBC_ABI_DT_X86_64_PLT not found).
_LIBYANG_LIB_DIRS = ":".join([
    # libyang.so.3 itself (soname symlink included, from :yang_files).
    "../libyang3++_repo_rules+libyang3_src",
    # pcre2 + libxxhash, extracted from their apt tars by :runtime_libs.
    "../libyang3-py3+/runtime_libs",
])

# The crm suites parse the whole 146-model set per case and are genuinely slow
# (test_dash_crm takes ~47s), so they need more than the default "small" budget.
_SLOW_TESTS = [
    "test_crm",
    "test_dash_crm",
]

[sonic_py_pytest_test(
    name = f[len("tests/yang_model_pytests/"):-len(".py")],
    test_file = f,
    size = "medium" if f[len("tests/yang_model_pytests/"):-len(".py")] in _SLOW_TESTS else "small",
    env = {"LD_LIBRARY_PATH": _LIBYANG_LIB_DIRS},
    # venv name from pyproject.toml [project].name.
    venv = "sonic-yang-models",
    deps = [":pytest_lib"],
) for f in glob(["tests/yang_model_pytests/test_*.py"])]
