# =============================================================================
# Unit tests. Bazel equivalent of the Make-side test step in slave.mk's
# SONIC_PYTHON_WHEELS recipe (pip install ".[testing]" + python3 -m pytest,
# which gates the wheel).
#
# The suites do not touch a live redis or the real swsscommon: each test file
# does `sys.modules["swsscommon"] = swsscommon_test` (tests/swsscommon_test.py,
# a pure-Python fake) and mocks subprocess, so only the first-party bgpcfgd
# packages + jinja2/netaddr/pyyaml are needed.
#
# Eight of the suites reach OUT of this module with CWD-relative paths, because
# Make runs pytest from src/sonic-bgpcfgd inside the monorepo:
#   * '../../dockers/docker-fpm-frr/frr'  -- 51 jinja2 templates, owned by
#     docker-fpm-frr, rendered by test_bgp/_setsrc/_templates/_bbr_templates/
#     _chassis_app_db/_device_global/_ipv6_nexthop_global/_prefix_list;
#   * '../../files/image_config/constants/constants.yml' -- tests/util.py;
#   * '../sonic-bgpcfgd/tests/data/...' -- the module's OWN fixtures, addressed
#     through the sibling name (test_chassis_app_db, test_device_global).
# Both outside dirs belong to the root module, which a dependency module cannot
# see, so they are vendored under bazel/vendor/ and staged into a
# monorepo-shaped tree below (:mono_*). That unblocks all eight.
#
# test_sonic-cfggen.py stays excluded: it shells out to the `sonic-cfggen`
# console script, which lives in sonic-config-engine and is not a dependency of
# this module. Fixtures alone do not help. Tracked in
# test_docs/module_log/sonic-bgpcfgd_module_log.md.
_EXCLUDED_TESTS = [
    "tests/test_sonic-cfggen.py",
]

# Monorepo-shaped staging tree. The suites' paths are relative to the CWD Make
# uses (src/sonic-bgpcfgd), so the tree has to reproduce two levels above it:
#
#   _mono/
#   |-- dockers/docker-fpm-frr/frr/       <- '../../dockers/...'
#   |-- files/image_config/constants/     <- '../../files/...'
#   `-- src/sonic-bgpcfgd/tests/          <- CWD (SONIC_TEST_CHDIR), so both
#                                            './tests/...' and
#                                            '../sonic-bgpcfgd/tests/...' work
#
# One copy_to_directory per subtree: their `out` paths must not overlap.
copy_to_directory(
    name = "mono_self",
    testonly = True,
    srcs = glob(["tests/**"]),
    out = "_mono/src/sonic-bgpcfgd/tests",
    replace_prefixes = {"tests/": ""},
)

copy_to_directory(
    name = "mono_frr",
    testonly = True,
    srcs = ["//bazel/vendor:frr_templates"],
    out = "_mono/dockers/docker-fpm-frr/frr",
    root_paths = ["bazel/vendor/dockers/docker-fpm-frr/frr"],
)

copy_to_directory(
    name = "mono_constants",
    testonly = True,
    srcs = ["//bazel/vendor:constants"],
    out = "_mono/files/image_config/constants",
    root_paths = ["bazel/vendor/files/image_config/constants"],
)

_MONO_DATA = [
    ":mono_constants",
    ":mono_frr",
    ":mono_self",
]

# Runfiles-relative; the canonical repo name of a dependency module carries a '+'.
_MONO_CHDIR = "sonic-bgpcfgd+/_mono/src/sonic-bgpcfgd"

py_library(
    name = "pytest_lib",
    testonly = True,
    data = glob(["tests/**"], exclude = ["tests/**/*.py"]),
    imports = ["."],
    deps = [
        ":bgpcfgd_lib",
        ":bgpmon_lib",
        ":bfdmon_lib",
        ":staticroutebfd_lib",
        ":tests_lib",
        "@sonic-swss-common//pybind:swsscommon",
        "@sonic-py-common//:sources",
        "@sonic_bgpcfgd_pip//jinja2",
        "@sonic_bgpcfgd_pip//mock",
        "@sonic_bgpcfgd_pip//natsort",
        "@sonic_bgpcfgd_pip//netaddr",
        "@sonic_bgpcfgd_pip//pytest",
        "@sonic_bgpcfgd_pip//pyyaml",
    ],
)

[sonic_py_pytest_test(
    name = f[len("tests/"):-len(".py")],
    test_file = f,
    venv = "sonic-bgpcfgd",
    data = _MONO_DATA,
    # Run from inside the staged tree so every CWD-relative fixture path in the
    # suites resolves. Harmless for the suites that only import python.
    env = {"SONIC_TEST_CHDIR": _MONO_CHDIR},
    deps = [":pytest_lib"],
) for f in glob(
    ["tests/test_*.py"],
    exclude = _EXCLUDED_TESTS,
)]

py_wheel(
    name = "wheel",
    distribution = "sonic_bgpcfgd",
    version = "1.0",
    requires = [
        "jinja2>=2.10",
        "netaddr==0.8.0",
        "pyyaml>=6.0.1",
    ],
    entry_points = {
        "console_scripts": [
            "bgpcfgd = bgpcfgd.main:main",
            "staticroutebfd = staticroutebfd.main:main",
            "bgpmon = bgpmon.bgpmon:main",
            "bfdmon = bfdmon.bfdmon:main",
        ],
    },
    deps = [
        ":bgpcfgd_lib",
        ":bgpmon_lib",
        ":bfdmon_lib",
        ":staticroutebfd_lib",
        ":tests_lib",
    ],
    visibility = ["//visibility:public"],
)

write_file(
    name = "bgpcfgd_console_script",
    out = "bgpcfgd_bin",
    content = [
        "#!/usr/bin/python3",
        "# -*- coding: utf-8 -*-",
        "import re",
        "import sys",
        "from bgpcfgd.main import main",
        "if __name__ == '__main__':",
        "    sys.argv[0] = re.sub(r'(-script\\.pyw|\\.exe)?$', '', sys.argv[0])",
        "    sys.exit(main())",
    ],
)

