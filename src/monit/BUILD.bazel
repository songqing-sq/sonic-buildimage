load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@sonic_build_infra//sonic_deb:sonic_deb.bzl", "sonic_deb")
load(":config_defines.bzl", "ARCH", "CONFIG_DEFINES", "SYSCONFDIR", "XCONFIG_DEFINES", "config_h_cmd")

package(default_visibility = ["//visibility:public"])

# rules/monit.mk pins MONIT_VERSION = 5.34.3-1; the deb's Version: carries
# Debian's epoch.
VERSION = "5.34.3-1"

DEB_VERSION = "1:5.34.3-1"

exports_files(["monit_src.BUILD"])

# ---------------------------------------------------------------------------
# What ./configure would emit (it probes the host compiler and libc).
# ---------------------------------------------------------------------------
genrule(
    name = "gen_config_h",
    srcs = ["@monit_src//:src/config.h.in"],
    outs = ["config.h"],
    cmd = config_h_cmd(CONFIG_DEFINES),
)

# libmonit carries its own autoconf header, separate from src/config.h.
genrule(
    name = "gen_xconfig_h",
    srcs = ["@monit_src//:libmonit/src/xconfig.h.in"],
    outs = ["xconfig.h"],
    cmd = config_h_cmd(XCONFIG_DEFINES),
)

cc_library(
    name = "monit_config",
    hdrs = [
        "config.h",
        "xconfig.h",
    ],
    includes = ["."],
)

# ---------------------------------------------------------------------------
# The parser. SONiC's 0002-change_monit_alert_log_error.patch edits src/p.y
# (adding `ALERT repeat` to the grammar), so the y.tab.c shipped in the tarball
# is stale and bison has to run for real.
#
# The lexer is NOT regenerated: no patch touches src/l.l, so the pre-generated
# src/lex.yy.c is used as-is, which also avoids needing flex here.
# ---------------------------------------------------------------------------
genrule(
    name = "gen_parser",
    srcs = ["@monit_src//:src/p.y"],
    outs = [
        "y.tab.c",
        "y.tab.h",
    ],
    cmd = ("set -e; " +
           "BISON=$$(realpath $(execpath @sonic_build_infra//kernel/tools:bison_bin)); " +
           # bison shells out to m4 and reads its skeletons from
           # BISON_PKGDATADIR; both live in its runfiles tree.
           "RF=$$BISON.runfiles; " +
           "export M4=$$(echo $$RF/rules_m4*/bin/m4); " +
           "export BISON_PKGDATADIR=$$(echo $$RF/rules_bison*/data); " +
           "$$BISON -y -d -o $(location y.tab.c) $<"),
    tools = ["@sonic_build_infra//kernel/tools:bison_bin"],
)

cc_library(
    name = "parser_hdrs",
    hdrs = ["y.tab.h"],
    includes = ["."],
)

# Debian hardening (debian/rules: DEB_BUILD_MAINT_OPTIONS=hardening=+all).
# The hermetic toolchain supplies -O2/-DNDEBUG but not stack-protector, so it is
# added explicitly to restore __stack_chk_fail.
#
# Same approach and same residual gaps as src/wpasupplicant, none of which this
# module can close:
#   - FORTIFY (__printf_chk etc.): the sysroot glibc headers emit no fortified
#     calls even with -D_FORTIFY_SOURCE, so Make's binary imports the _chk
#     variants and this one imports the plain ones.
#   - __assert_fail: opt mode forces -DNDEBUG after user copts.
#   - stdout / optind / environ and friends: Make's binary leaves these
#     undefined for the dynamic loader, while this link resolves them as copy
#     relocations into .bss. Same glibc objects either way.
# RELRO, BIND_NOW and stack-protector DO match Make's binary.
HARDEN_COPTS = [
    "-fstack-protector-strong",
    "-Wformat",
    "-Wformat-security",
]

# dpkg-buildflags LDFLAGS: relro + immediate binding.
HARDEN_LINKOPTS = [
    "-Wl,-z,relro",
    "-Wl,-z,now",
]

# From configure's CFLAGS. -std=c11 (strict, not gnu11) is load-bearing: monit.h
# declares `struct { ... } unix;` members, and in a GNU dialect `unix` is a
# predefined macro, so the struct fails to parse.
_COPTS = [
    "-std=c11",
    "-D_GNU_SOURCE",
    "-D_REENTRANT",
    "-DHAVE_CONFIG_H",
    # AM_CPPFLAGS.
    "-D" + ARCH,
    "-DSYSCONFDIR=\\\"{}\\\"".format(SYSCONFDIR),
] + HARDEN_COPTS

_DEPS = [
    ":monit_config",
    ":parser_hdrs",
    "@monit_deps//libssl-dev:ssl",
    "@monit_deps//libssl-dev:crypto",
    "@monit_deps//zlib1g-dev:z",
    "@monit_deps//libpam0g-dev:pam",
    "@monit_deps//libcrypt-dev:crypt",
    "@monit_src//:hdrs_lib",
]

# libmonit/Makefile.am libmonit_la_SOURCES.
cc_library(
    name = "libmonit",
    srcs = ["@monit_src//:libmonit_srcs"],
    copts = _COPTS,
    linkstatic = True,
    deps = _DEPS,
)

# Makefile.am monit_SOURCES. sysdep_@ARCH@ is resolved in monit_src.BUILD.
cc_binary(
    name = "monit",
    srcs = ["@monit_src//:monit_srcs"] + [
        "y.tab.c",
        # Not regenerated: no patch touches src/l.l.
        "@monit_src//:src/lex.yy.c",
    ],
    copts = _COPTS,
    # Drops libstdc++/libgcc_s, which cc_binary's C++ driver would otherwise add.
    #
    # KNOWN DIVERGENCE: DT_NEEDED still lists libzstd / libaudit / libcap-ng,
    # which Make's binary does not, because the apt cc_imports propagate their
    # own transitive deps. All are in the base rootfs and the built-in feature
    # set matches Make's ("ssl, ipv6, compression, pam"), so this is cosmetic.
    linkopts = HARDEN_LINKOPTS + ["-Wl,--as-needed"],
    deps = _DEPS + [
        ":libmonit",
        "@monit_src//:textual_includes",
    ],
)

# debian/monit.install installs these under new names. The content key's middle
# field is a strip prefix rather than a rename, so the renames happen here.
genrule(
    name = "gen_monit_default",
    srcs = ["@monit_src//:debian/monit.default"],
    outs = ["renamed/monit_default/monit"],
    cmd = "cp $< $@",
)

genrule(
    name = "gen_monit_init",
    srcs = ["@monit_src//:debian/monit.init"],
    outs = ["renamed/monit_init/monit"],
    cmd = "cp $< $@",
)

genrule(
    name = "gen_monit_logrotate",
    srcs = ["@monit_src//:debian/monit.logrotate"],
    outs = ["renamed/monit_logrotate/monit"],
    cmd = "cp $< $@",
)

genrule(
    name = "gen_monit_pam",
    srcs = ["@monit_src//:debian/monit.pam"],
    outs = ["renamed/monit_pam/monit"],
    cmd = "cp $< $@",
)

genrule(
    name = "gen_monit_bugscript",
    srcs = ["@monit_src//:debian/monit.bug-script"],
    outs = ["renamed/monit_bugscript/monit"],
    cmd = "cp $< $@",
)

genrule(
    name = "gen_monit_service",
    srcs = ["@monit_src//:debian/monit.service"],
    outs = ["renamed/service/monit.service"],
    cmd = "cp $< $@",
)

genrule(
    name = "gen_monit_completion",
    srcs = ["@monit_src//:system/bash/monit"],
    outs = ["renamed/completion/monit"],
    cmd = "cp $< $@",
)

# ---------------------------------------------------------------------------
# The deb. Layout from debian/monit.install + debian/monit.dirs.
# ---------------------------------------------------------------------------
sonic_deb(
    name = "monit_{}.deb".format(VERSION),
    package = "monit",
    version = DEB_VERSION,
    content = {
        "/usr/bin:*:0755": [":monit"],
        "/etc/monit:*:0600": ["@monit_src//:monitrc"],
        "/etc/monit/conf-available:*:0644": ["@monit_src//:conf_available"],
        "/etc/monit/templates:*:0644": ["@monit_src//:conf_templates"],
        "/usr/share/bash-completion/completions:*:0644": [":gen_monit_completion"],
        "/etc/default:*:0644": [":gen_monit_default"],
        "/etc/init.d:*:0755": [":gen_monit_init"],
        "/etc/logrotate.d:*:0644": [":gen_monit_logrotate"],
        "/etc/pam.d:*:0644": [":gen_monit_pam"],
        "/usr/lib/systemd/system:*:0644": [":gen_monit_service"],
        "/usr/share/bug:*:0755": [":gen_monit_bugscript"],
    },
    # debian/monit.dirs.
    empty_dirs = [
        "/etc/monit/conf.d",
        "/etc/monit/conf-enabled",
        "/var/lib/monit/events",
    ],
    pre_depends = ["init-system-helpers (>= 1.54~)"],
    depends = [
        "libc6 (>= 2.38)",
        "libcrypt1 (>= 1:4.1.0)",
        "libpam0g (>= 0.99.7.1)",
        "libssl3t64 (>= 3.0.0)",
        "zlib1g (>= 1:1.2.0)",
    ],
    suggests = [
        "default-mta | postfix | mail-transport-agent",
        "sysvinit-core",
    ],
    maintainer = "Fabio Augusto De Muzio Tobich <ftobich@debian.org>",
    description = "utility for monitoring and managing daemons or similar programs\n monit is a utility for monitoring and managing daemons or similar\n programs running on a Unix system. It will start specified programs\n if they are not running and restart programs not responding.",
    homepage = "https://mmonit.com/monit/",
    section = "admin",
    priority = "optional",
    gen_dbg = True,
)
