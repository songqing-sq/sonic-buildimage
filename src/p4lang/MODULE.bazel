    type = "tar.gz",
    urls = ["https://codeload.github.com/p4lang/p4runtime/tar.gz/ec4eb5ef70dbcbcbf2f8357a4b2b8c2f218845a5"],
)

sonic_http_archive(
    name = "pi_gnmi",
    build_file_template = "//:gnmi-proto.BUILD",
    sha256 = "3701005f28044065608322c179625c8898beadb80c89096b3d8aae1fbac15108",
    strip_prefix = "gnmi-39cb2fffed5c9a84970bde47b3d39c8c716dc17a/proto",
    type = "zip",
    urls = ["https://github.com/openconfig/gnmi/archive/39cb2fffed5c9a84970bde47b3d39c8c716dc17a.zip"],
