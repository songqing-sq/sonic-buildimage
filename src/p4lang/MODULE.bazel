sonic_http_archive = use_repo_rule(
    "@sonic_build_infra//sonic_http_archive:sonic_http_archive.bzl",
    "sonic_http_archive",
)
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "pi_uthash",
    build_file_content = """
cc_library(
    name = "uthash",
    hdrs = glob(["src/*.h"]),
    includes = ["src"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "c8ad8567f492d7297848c5ee9017fd5c7aa1af095690b53872966fc5ae434eb4",
    strip_prefix = "uthash-bf15263081be6229be31addd48566df93921cb46",
    type = "tar.gz",
    urls = ["https://codeload.github.com/troydhanson/uthash/tar.gz/bf15263081be6229be31addd48566df93921cb46"],
)

sonic_http_archive(
    name = "pi_googleapis",
    build_file_template = "//:googleapis-rpc.BUILD",
    sha256 = "7007eaad67b4afc9014e2646ea9c9e4e3aedf0eae9cd7dc7f38bbafae170ead8",
    strip_prefix = "googleapis-9fe00a1330817b5ce00919bf2861cd8a9cea1a00/google/rpc",
