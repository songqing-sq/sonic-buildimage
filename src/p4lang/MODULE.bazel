sonic_http_archive(name = "p4lang_pi_src", build_file_template = "//:p4lang-pi.BUILD", extra_files = ["//:pi_cli_dummy_main.c"], patches = ["//:pi-native-bazel.patch"], sha256 = "aa8ea06707e0220194e2b6a9599e9262225655c0286f047590400901f9f9adca", strip_prefix = "PI-0.1.1", type = "tar.gz", urls = ["https://codeload.github.com/p4lang/PI/tar.gz/refs/tags/v0.1.1"])
sonic_http_archive(name = "p4lang_bmv2_src", build_file_template = "//:p4lang-bmv2.BUILD", patches = ["//:bmv2-native-bazel.patch"], sha256 = "6690ee1dc1b8fcd4bfdb1b2a95b5c7950aed689dbaa7f279913e004666594299", strip_prefix = "behavioral-model-1.15.0", type = "tar.gz", urls = ["https://codeload.github.com/p4lang/behavioral-model/tar.gz/refs/tags/1.15.0"])
sonic_http_archive(name = "p4lang_p4c_src", patches = ["//:p4lang-p4c.patch/fix-build-for-boost-1.83.patch", "//:p4c-native-bazel.patch"], patch_strip = 1, patch_tool = "/usr/bin/patch", sha256 = "ba05aac6378cccc23bb3f682073e23e32d1d5fd04063de95f7ee8ce9f5435588", strip_prefix = "p4c-1.2.4.2", type = "tar.gz", urls = ["https://codeload.github.com/p4lang/p4c/tar.gz/refs/tags/v1.2.4.2"])

apt = use_extension("@rules_deb//apt:extensions.bzl", "apt")
apt.sources_list(architectures = ["amd64", "arm64"], components = ["main"], suites = ["trixie", "trixie-updates", "trixie-security"], uris = ["https://sonic-build.alibaba-inc.com/debian_snapshot/20260410"])
apt.install(
    dependency_set = "p4lang_pi_deps",
    packages = ["libreadline-dev"],
    suites = ["trixie", "trixie-updates", "trixie-security"],
)
apt.install(
    dependency_set = "p4lang_backend_deps",
    packages = [
        "libboost-dev", "libboost-filesystem-dev", "libboost-filesystem1.83-dev", "libboost-graph-dev",
        "libboost-iostreams-dev", "libboost-program-options-dev",
        "libboost-program-options1.83-dev", "libboost-system-dev", "libboost-thread-dev", "libboost-thread1.83-dev", "libelf-dev",
        "libfl-dev", "libgc-dev", "libgmp-dev", "libnanomsg-dev", "libpcap-dev", "libpcap0.8-dev",
        "libssl-dev", "libthrift-dev",
    ],
    suites = ["trixie", "trixie-updates", "trixie-security"],
)
use_repo(apt, "p4lang_backend_deps", "p4lang_pi_deps")
