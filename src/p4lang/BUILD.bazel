genrule(
    name = "p4c_driver",
    srcs = ["@p4lang_p4c_src//:tools/driver/p4c.in"],
    outs = ["p4c"],
    cmd = "sed -e 's|@datarootdir@|$${prefix}/share|g' -e 's|@exec_prefix@|$${prefix}|g' -e 's|@prefix@|/usr|g' -e 's|@P4C_VERSION@|1.2.4.2|g' $(SRCS) > $@ && chmod 0755 $@",
)

genrule(name = "p4c_bm2_ss_bin", srcs = ["@p4lang_p4c_src//:p4c_bmv2"], outs = ["p4c-bm2-ss"], cmd = "cp $(SRCS) $@ && chmod 0755 $@")
genrule(name = "p4c_bm2_psa_bin", srcs = ["@p4lang_p4c_src//:p4c_bmv2_psa"], outs = ["p4c-bm2-psa"], cmd = "cp $(SRCS) $@ && chmod 0755 $@")
genrule(name = "p4c_dpdk_bin", srcs = ["@p4lang_p4c_src//:p4c_dpdk"], outs = ["p4c-dpdk"], cmd = "cp $(SRCS) $@ && chmod 0755 $@")
genrule(name = "p4c_ebpf_bin", srcs = ["@p4lang_p4c_src//:p4c_ebpf"], outs = ["p4c-ebpf"], cmd = "cp $(SRCS) $@ && chmod 0755 $@")
genrule(name = "p4c_ubpf_bin", srcs = ["@p4lang_p4c_src//:p4c_ubpf"], outs = ["p4c-ubpf"], cmd = "cp $(SRCS) $@ && chmod 0755 $@")
genrule(name = "p4c_pna_p4tc_bin", srcs = ["@p4lang_p4c_src//:p4c_pna_p4tc"], outs = ["p4c-pna-p4tc"], cmd = "cp $(SRCS) $@ && chmod 0755 $@")
genrule(name = "p4test_bin", srcs = ["@p4lang_p4c_src//:p4c_backend_p4test"], outs = ["p4test"], cmd = "cp $(SRCS) $@ && chmod 0755 $@")
genrule(name = "p4c_graphs_bin", srcs = ["@p4lang_p4c_src//:p4c_graphs"], outs = ["p4c-graphs"], cmd = "cp $(SRCS) $@ && chmod 0755 $@")

filegroup(
    name = "p4c_driver_files",
    srcs = [
        "@p4lang_p4c_src//:tools/driver/p4c_src/__init__.py",
