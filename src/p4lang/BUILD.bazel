        "@p4lang_bmv2_src//:dataplane_interface_py_proto",
        "@p4lang_bmv2_src//:dataplane_interface_py_grpc",
    ],
)

bmv2_header_tree(
    name = "bmv2_headers",
    srcs = [
        "@p4lang_bmv2_src//:bmv2_install_header_sources",
        "@p4lang_bmv2_src//:standard_thrift_gen",
        "@p4lang_bmv2_src//:simple_pre_thrift_gen",
        "@p4lang_bmv2_src//:simple_pre_lag_thrift_gen",
