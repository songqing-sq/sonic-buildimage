load("@sonic_build_infra//sonic_deb:sonic_deb.bzl", "sonic_deb")
load("@tar.bzl", "tar")
load(":python_install_tree.bzl", "pi_python_install_tree")
load(":bmv2_install.bzl", "bmv2_header_tree", "bmv2_library_links", "bmv2_python_tree", "bmv2_python_wrapper")
load(":cc_headers_only.bzl", "cc_headers_only")

package(default_visibility = ["//visibility:public"])

cc_headers_only(
    name = "p4runtime_headers",
    deps = [
        "@com_github_grpc_grpc//:grpc++",
        "@pi_googleapis//:code_cc_proto",
        "@pi_p4runtime//:p4runtime_cc_grpc",
    ],
    generated = "@pi_p4runtime//:_p4runtime_cc_grpc_grpc_codegen",
    strip_include_prefix = "p4/v1",
)

alias(name = "libpiprotobuf", actual = "@p4lang_pi_src//proto:piprotobuf")
alias(name = "libpiprotogrpc", actual = "@p4lang_pi_src//proto:piprotogrpc")
alias(name = "pi_CLI_dummy", actual = "@p4lang_pi_src//:pi_CLI_dummy")
alias(name = "pi_gen_native_json", actual = "@p4lang_pi_src//:pi_gen_native_json")
alias(name = "pi_gen_fe_defines", actual = "@p4lang_pi_src//:pi_gen_fe_defines")
alias(name = "pi_convert_p4info", actual = "@p4lang_pi_src//proto/p4info:pi_convert_p4info")

filegroup(
    name = "pi_shared_libraries",
    srcs = [
        "@p4lang_pi_src//:libpi_files",
        "@p4lang_pi_src//:libpifegeneric_files",
        "@p4lang_pi_src//:libpi_dummy_files",
        "@p4lang_pi_src//frontends_extra/cpp:libpifecpp_files",
        "@p4lang_pi_src//proto:piprotobuf_files",
        "@p4lang_pi_src//proto:piprotogrpc_files",
    ],
)

filegroup(
    name = "pi_headers",
    srcs = [
        "@p4lang_pi_src//:pihdrs",
        "@p4lang_pi_src//frontends_extra/cpp:libpifecpp_hdr_files",
        "@p4lang_pi_src//proto:piprotobuf_hdr_files",
        "@p4lang_pi_src//proto:piprotogrpc_hdr_files",
    ],
)

pi_python_install_tree(
    name = "pi_python_proto_tree",
    srcs = ["@p4lang_pi_src//:pi_python_proto_tree"],
)

sonic_deb(
    name = "p4lang-pi_0.1.1-1.deb",
    package = "p4lang-pi",
    version = "0.1.1-1",
    section = "net",
    maintainer = "Radostin Stoyanov <radostin@stoyanov.io>",
    homepage = "https://github.com/p4lang/PI",
    description = "Implementation framework of a P4Runtime server",
    depends = [
        "libc6",
        "libgcc-s1",
        "libgrpc++1.51t64",
        "libprotobuf32t64",
        "libreadline8",
        "libstdc++6",
    ],
    content = {
        "${LIBDIR}:*:0644": [
            "@p4lang_pi_src//:libpi_files",
            "@p4lang_pi_src//:libpifegeneric_files",
            "@p4lang_pi_src//:libpi_dummy_files",
            "@p4lang_pi_src//frontends_extra/cpp:libpifecpp_files",
            "@p4lang_pi_src//proto:piprotobuf_files",
            "@p4lang_pi_src//proto:piprotogrpc_files",
        ],
        "/usr/include:include:0644": ["@p4lang_pi_src//:pihdrs"],
        "/usr/include:frontends_extra/cpp:0644": ["@p4lang_pi_src//frontends_extra/cpp:libpifecpp_hdr_files"],
        "/usr/include:proto:0644": [
            "@p4lang_pi_src//proto:piprotobuf_hdr_files",
            "@p4lang_pi_src//proto:piprotogrpc_hdr_files",
        ],
        "/usr/bin:*:0755": [
            ":pi_CLI_dummy",
            ":pi_convert_p4info",
            ":pi_gen_fe_defines",
            ":pi_gen_native_json",
        ],
        "/usr/lib/python3/dist-packages:pi_python:0644": [":pi_python_proto_tree"],
    },
    content_targets = [
        "@p4lang_pi_src//:libpi_shared",
        "@p4lang_pi_src//:libpifegeneric_shared",
        "@p4lang_pi_src//:libpi_dummy_shared",
        "@p4lang_pi_src//frontends_extra/cpp:libpifecpp_shared",
        "@p4lang_pi_src//proto:piprotobuf_shared",
        "@p4lang_pi_src//proto:piprotogrpc_shared",
    ],
)

tar(
    name = "pi_runtime_layer_amd64",
    srcs = [
        "@p4lang_pi_src//proto:piprotobuf_shared",
        "@p4lang_pi_src//proto:piprotobuf_files",
        "@p4lang_pi_src//proto:piprotogrpc_shared",
        "@p4lang_pi_src//proto:piprotogrpc_files",
    ],
    mtree = [
        "./usr/lib/x86_64-linux-gnu/libpiprotobuf.so.0.0.0 uid=0 gid=0 mode=0644 type=file content=$(location @p4lang_pi_src//proto:piprotobuf_shared)",
        "./usr/lib/x86_64-linux-gnu/libpiprotobuf.so.0 uid=0 gid=0 mode=0777 type=link link=libpiprotobuf.so.0.0.0",
        "./usr/lib/x86_64-linux-gnu/libpiprotogrpc.so.0.0.0 uid=0 gid=0 mode=0644 type=file content=$(location @p4lang_pi_src//proto:piprotogrpc_shared)",
        "./usr/lib/x86_64-linux-gnu/libpiprotogrpc.so.0 uid=0 gid=0 mode=0777 type=link link=libpiprotogrpc.so.0.0.0",
    ],
)

tar(
    name = "pi_runtime_layer_arm64",
    srcs = [
        "@p4lang_pi_src//proto:piprotobuf_shared",
        "@p4lang_pi_src//proto:piprotobuf_files",
        "@p4lang_pi_src//proto:piprotogrpc_shared",
        "@p4lang_pi_src//proto:piprotogrpc_files",
    ],
    mtree = [
        "./usr/lib/aarch64-linux-gnu/libpiprotobuf.so.0.0.0 uid=0 gid=0 mode=0644 type=file content=$(location @p4lang_pi_src//proto:piprotobuf_shared)",
        "./usr/lib/aarch64-linux-gnu/libpiprotobuf.so.0 uid=0 gid=0 mode=0777 type=link link=libpiprotobuf.so.0.0.0",
        "./usr/lib/aarch64-linux-gnu/libpiprotogrpc.so.0.0.0 uid=0 gid=0 mode=0644 type=file content=$(location @p4lang_pi_src//proto:piprotogrpc_shared)",
        "./usr/lib/aarch64-linux-gnu/libpiprotogrpc.so.0 uid=0 gid=0 mode=0777 type=link link=libpiprotogrpc.so.0.0.0",
    ],
)

alias(
    name = "pi_runtime_layer",
    actual = select({
        "@platforms//cpu:aarch64": ":pi_runtime_layer_arm64",
        "//conditions:default": ":pi_runtime_layer_amd64",
    }),
)

bmv2_python_wrapper(name = "bm_CLI", src = "@p4lang_bmv2_src//:tools/bm_CLI.in", output = "bm_CLI")
bmv2_python_wrapper(name = "bm_p4dbg", src = "@p4lang_bmv2_src//:tools/bm_p4dbg.in", output = "bm_p4dbg")
bmv2_python_wrapper(name = "bm_nanomsg_events", src = "@p4lang_bmv2_src//:tools/bm_nanomsg_events.in", output = "bm_nanomsg_events")
bmv2_python_wrapper(name = "simple_switch_CLI", src = "@p4lang_bmv2_src//:targets/simple_switch/simple_switch_CLI.in", output = "simple_switch_CLI")
bmv2_python_wrapper(name = "psa_switch_CLI", src = "@p4lang_bmv2_src//:targets/psa_switch/psa_switch_CLI.in", output = "psa_switch_CLI")

bmv2_python_tree(
    name = "bmv2_python_generated",
    srcs = [
        "@p4lang_bmv2_src//:standard_thrift_py",
        "@p4lang_bmv2_src//:simple_pre_thrift_py",
        "@p4lang_bmv2_src//:simple_pre_lag_thrift_py",
        "@p4lang_bmv2_src//:simple_switch_thrift_py",
        "@p4lang_bmv2_src//:psa_switch_thrift_py",
        "@p4lang_bmv2_src//:pdfixed_res_thrift_py",
        "@p4lang_bmv2_src//:pdfixed_conn_mgr_thrift_py",
