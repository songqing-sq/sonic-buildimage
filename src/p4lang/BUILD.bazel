        "@p4lang_bmv2_src//:psa_switch_thrift_gen",
        "@p4lang_bmv2_src//:dataplane_install_headers",
    ],
)

filegroup(
    name = "bmv2_shared_libraries",
    srcs = [
        "@p4lang_bmv2_src//:libbmpi_files",
        "@p4lang_bmv2_src//:libsimpleswitch_runner_files",
