module(
    name = "rasdaemon",
    version = "0.6.8-1",
)

bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "sonic-build-infra", version = "0.0.0", repo_name = "sonic_build_infra")
bazel_dep(name = "rules_distroless", version = "0.0.0", repo_name = "rules_deb")

# =============================================================================
# rasdaemon — built FROM SOURCE.
#
# SONiC applies 0001-Check-CPUs-online-not-configured.patch, which switches
# ras-events.c from sysconf(_SC_NPROCESSORS_CONF) to _SC_NPROCESSORS_ONLN. On a
# switch CPU where some cores are offline, the _CONF count is larger than the
# number of per-CPU trace buffers rasdaemon can actually open, so the unpatched
# daemon fails at startup. The patch is not upstream as of 0.6.8-1, so trixie's
# stock package is not a substitute.
#
# The source is the same salsa commit src/rasdaemon/Makefile pins. Debian's
# packaging lives in that repo, so there is no separate .debian tarball.
# =============================================================================
debian_source = use_repo_rule("@sonic_build_infra//debian_source:debian_source.bzl", "debian_source")

debian_source(
    name = "rasdaemon_src",
    build_file = "//:rasdaemon_src.BUILD",
    # No separate .debian tarball: this is a Debian-maintained git snapshot, so
    # debian/ (including debian/patches/series) is already in the orig tree.
    # The series is applied first, then SONiC's patch — the order
    # dpkg-buildpackage uses. Skipping it would leave ras-mc-ctl missing
    # ras-mc-ctl.patch's guard against an undef mainboard product_name.
    orig_sha256 = "5f0ab17214c714772d2c3bc2d2e478098f32b01acedb638bd1b9ebc6308bb839",
    orig_urls = ["https://salsa.debian.org/tai271828/rasdaemon/-/archive/51a7f485f8b2e2ae43e613f19c5a387595174132/rasdaemon-51a7f485f8b2e2ae43e613f19c5a387595174132.tar.gz"],
    patches = ["//:0001-Check-CPUs-online-not-configured.patch"],
    strip_prefix = "rasdaemon-51a7f485f8b2e2ae43e613f19c5a387595174132",
)

# sqlite3 (--enable-sqlite3: the ras-mc_event.db event log).
apt = use_extension("@rules_deb//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64", "arm64"],
    components = ["main"],
    suites = [
        "trixie",
        "trixie-updates",
    ],
    uris = ["https://snapshot.debian.org/archive/debian/20260409T202916Z"],
)
apt.sources_list(
    architectures = ["amd64", "arm64"],
    components = ["main"],
    suites = ["trixie-security"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20260409T182303Z"],
)
apt.install(
    dependency_set = "rasdaemon_deps",
    packages = [
        "libsqlite3-dev:amd64",
        "libsqlite3-dev:arm64",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "rasdaemon_deps")
