module(
    name = "kdump-tools",
    version = "1.10.7",
)

bazel_dep(name = "sonic-build-infra", version = "0.0.0", repo_name = "sonic_build_infra")
bazel_dep(name = "rules_distroless", version = "0.0.0", repo_name = "rules_deb")

# =============================================================================
# kdump-tools — packaged FROM SOURCE (all shell scripts, nothing to compile).
#
# SONiC applies four patches that change crashdump behaviour, so trixie's
# 1:1.10.7 binary is not a substitute:
#   0002-core-file-prefixed-by-kdump      names the dump file kdump-<date>
#   0003-Revert-the-MODULES-dep-optimization
#   0004-disable-kdump-load-check         skips the "already loaded" bail-out
#   0005-Generate-initrd-for-kdump-on-build-time
#
# kdump-tools is a Debian NATIVE package: one tarball with debian/ inside, so
# there is no orig/debian split.
# =============================================================================
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "kdump_tools_src",
    build_file = "//:kdump_tools_src.BUILD",
    patch_args = ["-p1"],
    # Order is patch/series.
    patches = [
        "//:patch/0002-core-file-prefixed-by-kdump.patch",
        "//:patch/0003-Revert-the-MODULES-dep-optimization.patch",
        "//:patch/0004-disable-kdump-load-check.patch",
        "//:patch/0005-Generate-initrd-for-kdump-on-build-time.patch",
    ],
    sha256 = "3630506f228420a96c030605009a94a7a3b878df89d1903e8bd1205dafb913bd",
    strip_prefix = "kdump-tools-1.10.7",
    urls = ["https://deb.debian.org/debian/pool/main/k/kdump-tools/kdump-tools_1.10.7.tar.xz"],
)
