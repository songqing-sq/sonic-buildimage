module(
    name = "libpam-radius-auth",
    version = "1.4.1-1",
)

bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "sonic-build-infra", version = "0.0.0", repo_name = "sonic_build_infra")
bazel_dep(name = "rules_distroless", version = "0.0.0", repo_name = "rules_deb")

# =============================================================================
# libpam-radius-auth — built FROM SOURCE.
#
# Debian trixie ships libpam-radius-auth 2.0.0-1, but that is NOT a substitute:
# SONiC pins the 1.4.1-1 fork specifically for RADIUS Management Privilege Level
# support, added by debian/patches/0002-peap-mschapv2-support.patch and
# 0003-nas-ip-address-config.patch. 2.0.0 is the standalone pam_radius module
# without the FreeRADIUS bundle those patches build against, so re-wrapping it
# would drop MPL, CHAP and the per-server statistics feature.
#
# Two git snapshots, the same commits src/radius/pam/Makefile clones:
#   pam_radius        149c25df — "latest commit with Radius MPL support"
#   freeradius-server 5f715dba — supplies libradius-1.1.8 / libeap-1.1.8, which
#                                pam_radius_auth.so links against (confirmed in
#                                its DT_NEEDED).
# =============================================================================
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "pam_radius_src",
    build_file = "//:pam_radius_src.BUILD",
    sha256 = "3b45c13f4fa009a68b391338484050b91f9f37363ddb88c4cba59b137e932b3a",
    strip_prefix = "pam_radius-149c25df84cf5cd0e9addd9346699a9ca8fdddd2",
    # The codeload URL has no archive suffix for Bazel to infer from.
    type = "tar.gz",
    urls = ["https://codeload.github.com/FreeRADIUS/pam_radius/tar.gz/149c25df84cf5cd0e9addd9346699a9ca8fdddd2"],
    # The patches are written against `pam_radius/<path>`, since quilt applies
    # them from src/radius/pam/ one level up.
    patch_args = ["-p1"],
    patches = [
        "//:debian/patches/0001-chap-support.patch",
        "//:debian/patches/0002-peap-mschapv2-support.patch",
        "//:debian/patches/0003-nas-ip-address-config.patch",
        "//:debian/patches/0004-fix-blastradius.patch",
    ],
)

http_archive(
    name = "freeradius_src",
    build_file = "//:freeradius_src.BUILD",
    sha256 = "8f95c10749877ff00e03a58aad4662063e30de57f8eb45cc9094d2f2028b82b9",
    strip_prefix = "freeradius-server-5f715dba4d2dbdb268bf60fcc656352274930941",
    type = "tar.gz",
    urls = ["https://codeload.github.com/FreeRADIUS/freeradius-server/tar.gz/5f715dba4d2dbdb268bf60fcc656352274930941"],
    # Only the OpenSSL 1.0 deprecation fix is needed here: the other three
    # patches in freeradius/patches/ (freeradius_configure, config.sub/guess,
    # libltdl_config_sub) exist to make ./configure and libtool work, and this
    # build compiles the two libraries directly instead of running either.
    patch_args = ["-p1"],
    patches = ["//:freeradius/patches/freeradius_libeap_deprecated_openssl_1_0.patch"],
)

# libpam (PAM module ABI) and libssl (libeap's TLS/MSCHAPv2 crypto).
apt = use_extension("@rules_deb//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64", "arm64"],
    components = ["main"],
    suites = [
        "trixie",
        "trixie-updates",
    ],
    uris = ["https://snapshot.debian.org/archive/debian/20260409T202916Z"],
)
apt.sources_list(
    architectures = ["amd64", "arm64"],
    components = ["main"],
    suites = ["trixie-security"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20260409T182303Z"],
)
apt.install(
    dependency_set = "pam_radius_deps",
    packages = [
        "libpam0g-dev:amd64",
        "libpam0g-dev:arm64",
        "libssl-dev:amd64",
        "libssl-dev:arm64",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "pam_radius_deps")
