module(
    name = "sonic-sysmgr",
    version = "1.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "29.0")
bazel_dep(name = "rules_distroless", version = "0.0.0", repo_name = "rules_deb")
bazel_dep(name = "sonic-build-infra", version = "0.0.0", repo_name = "sonic_build_infra")
bazel_dep(name = "sonic-swss-common", version = "1.0.0")
bazel_dep(name = "libnl3", version = "3.7.0")
bazel_dep(name = "libyang3", version = "3.12.2")
bazel_dep(name = "gnoi", version = "0.0.0")

apt = use_extension("@rules_deb//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "sysmgr_deps",
    packages = [
        "libdbus-c++-bin:amd64",
        "libdbus-c++-bin:arm64",
        "libdbus-c++-dev:amd64",
        "libdbus-c++-dev:arm64",
        "libdbus-c++-1-0v5:amd64",
        "libdbus-c++-1-0v5:arm64",
        "libdbus-1-dev:amd64",
        "libdbus-1-dev:arm64",
        "libdbus-1-3:amd64",
        "libdbus-1-3:arm64",
        "libprotobuf-dev:amd64",
        "libprotobuf-dev:arm64",
        "libprotobuf32t64:amd64",
        "libprotobuf32t64:arm64",
        "protobuf-compiler:amd64",
        "protobuf-compiler:arm64",
        "libprotoc32t64:amd64",
        "libprotoc32t64:arm64",
        # dbusxx-xml2cpp is a trixie binary run as a genrule tool. It is driven
        # through THIS ld.so with an explicit --library-path so the action does
        # not resolve libc against the build host's /lib64, which breaks on any
        # host whose glibc is older than trixie's. Its full DT_NEEDED set is
        # libexpat / libstdc++ / libgcc_s / libc, so all four ship here.
        "libc6:amd64",
        "libc6:arm64",
        "libexpat1:amd64",
        "libexpat1:arm64",
        "libstdc++6:amd64",
        "libstdc++6:arm64",
        "libgcc-s1:amd64",
        "libgcc-s1:arm64",
    ],
    suites = ["trixie", "trixie-updates", "trixie-security"],
)
use_repo(apt, "sysmgr_deps")
