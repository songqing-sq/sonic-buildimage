module(
    name = "sedutil",
    version = "1.15-5ad84d8",
)

bazel_dep(name = "sonic-build-infra", version = "0.0.0", repo_name = "sonic_build_infra")
bazel_dep(name = "rules_distroless", version = "0.0.0", repo_name = "rules_deb")

# =============================================================================
# sedutil — a PREBUILT binary, not compiled from source.
#
# This mirrors what src/sedutil/Makefile does: it wgets a release zip from
# github.com/ChubbyAnt/sedutil containing an already-built sedutil-cli, and wraps
# it in a .deb with dpkg-deb. There is no compile step in the Make build either,
# so fetching the same artifact with a pinned sha256 is as hermetic as the source
# allows — the same situation as the FIPS debs in src/sonic-fips.
#
# Not available from Debian at all: 1.15-5ad84d8 is a git-snapshot fork with no
# Debian release.
# =============================================================================
# http_archive rather than http_file: Bazel unpacks the zip itself, so the build
# needs no host `unzip` (which the Make recipe calls).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "sedutil_cli",
    build_file = "//:sedutil_cli.BUILD",
    sha256 = "8df1e6b9deb5ba97fe69a695acdb829de8cea39522a710bdb811f9dd74e6b74a",
    urls = ["https://github.com/ChubbyAnt/sedutil/releases/download/1.15-5ad84d8/sedutil-cli-1.15-5ad84d8.zip"],
)
