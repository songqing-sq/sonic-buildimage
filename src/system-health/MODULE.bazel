module(
    name = "system-health",
    version = "1.0",
)

bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "aspect_rules_py", version = "1.11.7")
bazel_dep(name = "tar.bzl", version = "0.8.1")

# Test-only deps. The suite needs sonic-py-common (device_info/multi_asic),
# swsscommon's python bindings and sonic-config-engine's mock_tables, plus the
# third-party packages the uv hub provides below.
bazel_dep(name = "sonic-build-infra", version = "0.0.0", repo_name = "sonic_build_infra")
bazel_dep(name = "sonic-py-common", version = "1.0")
bazel_dep(name = "sonic-swss-common", version = "1.0.0")
bazel_dep(name = "rules_distroless", version = "0.0.0", repo_name = "rules_deb")

# Test-only: dbus + gi (PyGObject). test_system_health patches
# 'dbus.mainloop.glib.DBusGMainLoop' and 'gi.repository.GLib.MainLoop', and
# mock.patch has to import a module before it can replace an attribute on it,
# so both have to be importable even though every call is mocked out.
#
# These come from apt, not the uv hub: PyPI ships dbus-python and PyGObject as
# sdists only, whose builds need meson plus the libdbus-1/glib/gobject-
# introspection dev headers -- none of which exist in the hermetic sandbox. The
# slave container has the same two packages preinstalled via apt
# (sonic-slave-trixie/Dockerfile), so taking Debian's prebuilt cp313
# extensions matches the Make side exactly and skips the rebuild.
#
# Deliberately NOT libc6/libstdc++6/libgcc-s1: a py_venv_test runs under the
# host interpreter and cannot re-exec through a matched loader the way
# //cc:test_runner.sh does, so staging a trixie glibc ahead of the host's would
# kill the process (see src/libyang3-py3/MODULE.bazel for the same note).
apt = use_extension("@rules_deb//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "system_health_apt",
    packages = [
        # The two python packages themselves (dbus/, gi/ + their cp313 .so).
        "python3-dbus:amd64",
        "python3-gi:amd64",
        # DT_NEEDED closure of _dbus_bindings.so and _gi.so.
        "libdbus-1-3:amd64",
        "libglib2.0-0t64:amd64",
        "libgirepository-1.0-1:amd64",
        "libffi8:amd64",
        # gi.repository.GLib resolves GLib-2.0.typelib at import time through
        # libgirepository; the typelibs live in their own package.
        "gir1.2-glib-2.0:amd64",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "system_health_apt")

uv = use_extension("@aspect_rules_py//uv/unstable:extension.bzl", "uv")
uv.declare_hub(hub_name = "system_health_pip")
uv.project(
    hub_name = "system_health_pip",
    pyproject = "//bazel:pyproject.toml",
    lock = "//bazel:uv.lock",
)
use_repo(uv, "system_health_pip")
