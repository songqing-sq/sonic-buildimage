load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_python//python:packaging.bzl", "py_wheel")
load("@sonic_build_infra//python:pytest_test.bzl", "sonic_py_pytest_test")
load("@tar.bzl", "tar")

package(default_visibility = ["//visibility:public"])

# rules/sonic-py-common.mk pins version 1.0 (setup.py `version`).
VERSION = "1.0"

# setup.py: packages=['sonic_py_common']. Package sources all live in
# `sonic_py_common/` at the module root.
#
# Note: all .py files are included (including sonic_db_dump_load.py) to match
# the Make wheel output (verified against
# target/python-wheels/trixie/sonic_py_common-1.0-py3-none-any.whl).
py_library(
    name = "sources",
    srcs = glob(["sonic_py_common/**/*.py"]),
    imports = ["."],
    visibility = ["//visibility:public"],
)

# bdist_wheel emits top_level.txt listing the top-level import names.
write_file(
    name = "top_level_txt",
    out = "top_level.txt",
    content = [
        "sonic_py_common",
        "",
    ],
)

# Wheel artifact: sonic_py_common-1.0-py3-none-any.whl
py_wheel(
    name = "wheel",
    distribution = "sonic-py-common",
    version = VERSION,
    # setup.py metadata — align with Make wheel METADATA.
    author = "SONiC Team",
    author_email = "linuxnetdev@microsoft.com",
    summary = "Common Python libraries for SONiC",
    homepage = "https://github.com/Azure/SONiC",
    license = "Apache 2.0",
    classifiers = [
        "Intended Audience :: Developers",
        "Operating System :: Linux",
        "Programming Language :: Python :: 2.7",
        "Programming Language :: Python :: 3.5",
        "Programming Language :: Python",
    ],
    # setup.py install_requires. sonic_dependencies + dependencies flat list:
    #   natsort, pyyaml, redis-dump-load
    requires = [
        "natsort",
        "pyyaml",
        "redis-dump-load",
    ],
    # setup.py entry_points.console_scripts
    entry_points = {
        "console_scripts": [
            "sonic-db-load = sonic_py_common.sonic_db_dump_load:sonic_db_dump_load",
            "sonic-db-dump = sonic_py_common.sonic_db_dump_load:sonic_db_dump_load",
        ],
    },
    # dist-info extras that bdist_wheel emits.
    extra_distinfo_files = {
        ":top_level_txt": "top_level.txt",
    },
    deps = [":sources"],
    visibility = ["//visibility:public"],
)

# Console-script shims that pip generates at `pip install` time.
write_file(
    name = "sonic_db_load_script",
    out = "sonic-db-load",
    content = [
        "#!/usr/bin/python3",
        "# -*- coding: utf-8 -*-",
        "import re",
        "import sys",
        "from sonic_py_common.sonic_db_dump_load import sonic_db_dump_load",
        "if __name__ == '__main__':",
        "    sys.argv[0] = re.sub(r'(-script\\.pyw|\\.exe)?$', '', sys.argv[0])",
        "    sys.exit(sonic_db_dump_load())",
    ],
)

write_file(
    name = "sonic_db_dump_script",
    out = "sonic-db-dump",
    content = [
        "#!/usr/bin/python3",
        "# -*- coding: utf-8 -*-",
        "import re",
        "import sys",
        "from sonic_py_common.sonic_db_dump_load import sonic_db_dump_load",
        "if __name__ == '__main__':",
        "    sys.argv[0] = re.sub(r'(-script\\.pyw|\\.exe)?$', '', sys.argv[0])",
        "    sys.exit(sonic_db_dump_load())",
    ],
)

# Install tar layer (OCI image consumer). Layout matches Debian system Python
# `pip3 install sonic_py_common-*.whl`.
_PY_FILES = [
    "__init__.py",
    "daemon_base.py",
    "device_info.py",
    "general.py",
    "interface.py",
    "logger.py",
    "multi_asic.py",
    "port_util.py",
    "security_cipher.py",
    "sidecar_common.py",
    "sonic_db_dump_load.py",
    "syslogger.py",
    "task_base.py",
    "util.py",
]

tar(
    name = "install",
    srcs = (
        ["sonic_py_common/" + f for f in _PY_FILES] +
        [":sonic_db_load_script", ":sonic_db_dump_script"]
    ),
    mtree = (
        [
            "./usr/lib/python3/dist-packages/sonic_py_common/" + f +
            " uid=0 gid=0 mode=0644 type=file content=$(location sonic_py_common/" + f + ")"
            for f in _PY_FILES
        ] +
        [
            "./usr/local/bin/sonic-db-load uid=0 gid=0 mode=0755 type=file content=$(location :sonic_db_load_script)",
            "./usr/local/bin/sonic-db-dump uid=0 gid=0 mode=0755 type=file content=$(location :sonic_db_dump_script)",
        ]
    ),
    visibility = ["//visibility:public"],
)

# =============================================================================
# Unit tests. Bazel equivalent of the Make-side test step in slave.mk's
# SONIC_PYTHON_WHEELS recipe:
#     pip3 install ".[testing]" && pip3 uninstall --yes <self>
#     timeout ... python3 -m pytest        # gate: wheel is built only if green
# Make baseline (target/python-wheels/trixie/sonic_py_common-*.whl.log):
# 71 passed across 10 test files.
#
# One py_test per test file instead of one monolithic pytest run: same case
# set, but parallel + per-file cacheable. The environment Make assembles
# imperatively (slave image preinstalls, `sudo pip install` of _DEPENDS
# wheels, `dpkg -i` of _DEBS_DEPENDS debs) is declared as deps here.
# =============================================================================
py_library(
    name = "tests_lib",
    testonly = True,
    srcs = glob(["tests/*.py"]),
    # "." keeps `tests` importable as a package so pytest's relative imports
    # (`from .mock_swsscommon import ...`) resolve exactly as they do when
    # Make runs pytest with rootdir=src/sonic-py-common.
    imports = ["."],
    deps = [
        # Code under test — the source tree itself, matching Make's
        # `pip3 uninstall --yes <self>` trick (test the sources, not an
        # installed copy).
        ":sources",
        # rules/sonic-py-common.mk _DEPENDS = SWSSSDK_PY3 (pip-installed wheel
        # on the Make side).
        "@sonic-py-swsssdk//:sources",
        # rules/sonic-py-common.mk _DEBS_DEPENDS = PYTHON3_SWSSCOMMON
        # (dpkg-installed SWIG binding on the Make side). Needed for real
        # (unmocked) `from swsscommon.swsscommon import ...` imports.
        "@sonic-swss-common//pybind:swsscommon",
        # setup.py sonic_dependencies = ['redis-dump-load'] (redisdl module).
        "@redis-dump-load-py3//:sources",
        # Slave-image / pip preinstalled third-party deps (see pyproject.toml).
        "@sonic_py_common_pip//pytest",
        "@sonic_py_common_pip//mock",
        "@sonic_py_common_pip//natsort",
        "@sonic_py_common_pip//pyyaml",
        "@sonic_py_common_pip//redis",
    ],
)

# Test-file inventory, one sonic_py_pytest_test each. Matches what pytest
# collects on the Make side (rootdir discovery of tests/): both test_*.py and
# *_test.py.
_TEST_FILES = [
    "device_info_test.py",
    "interface_test.py",
    "multi_asic_test.py",
    "test_daemon_base.py",
    "test_general.py",
    "test_port_util.py",
    "test_security_cipher.py",
    "test_sidecar_common.py",
    "test_sonic_db_dump_load.py",
    "test_syslogger.py",
]

[sonic_py_pytest_test(
    name = f[:-len(".py")],
    test_file = "tests/" + f,
    # venv name from bazel/pyproject.toml [project].name; the macro's
    # py_venv_test transition resolves the @sonic_py_common_pip hub deps
    # under this venv.
    venv = "sonic-py-common",
    deps = [":tests_lib"],
) for f in _TEST_FILES]

