load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("@sonic_build_infra//sonic_deb:sonic_deb.bzl", "sonic_deb")

package(default_visibility = ["//visibility:public"])

VERSION = "0.0.1-0"

exports_files(["Cargo.toml"])

# from_specs mode emits one target per direct dep (no aliases / all_crate_deps
# generator), so list them explicitly. Mirrors wol/Cargo.toml [dependencies].
_DIRECT_CRATES = [
    "@nettools_crates//:clap",
    "@nettools_crates//:pnet",
    "@nettools_crates//:libc",
]

rust_binary(
    name = "wol",
    srcs = [
        "wol/src/main.rs",
        "wol/src/socket.rs",
        "wol/src/wol.rs",
    ],
    crate_root = "wol/src/main.rs",
    edition = "2015",
    deps = _DIRECT_CRATES,
)

# Unit tests (Make: `test: cargo test`).
#
# The cases live in inline `#[cfg(test)] mod tests` blocks inside
# wol/src/wol.rs and wol/src/socket.rs, so `crate = ":wol"` recompiles the
# binary's own crate with --test rather than duplicating srcs and deps.
#
# Despite living in socket.rs, none of the cases opens a socket: they only build
# sockaddr_in / sockaddr_in6 structs and parse MAC and IP strings. So no
# CAP_NET_RAW and no runtime staging are needed.
rust_test(
    name = "wol_test",
    size = "small",
    crate = ":wol",
)

# debian/install: `bin/wol /usr/bin/` (the Makefile moves target/release/wol
# to bin/ first).
sonic_deb(
    name = "sonic-nettools_{}.deb".format(VERSION),
    package = "sonic-nettools",
    version = VERSION,
    content = {
        "/usr/bin:*:0755": [":wol"],
    },
    maintainer = "Wenda Chu <wendachu@microsoft.com>",
    description = "Networking command line tools",
    section = "custom",
    priority = "optional",
    # dh_strip: main deb carries the stripped binary, debug info goes to
    # sonic-nettools-dbgsym.
    gen_dbg = True,
    visibility = ["//visibility:public"],
)
