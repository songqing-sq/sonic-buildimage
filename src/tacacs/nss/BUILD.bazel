load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@sonic_build_infra//shared_library:shared_library.bzl", "sonic_shared_library_versioned")
load("@sonic_build_infra//sonic_deb:sonic_deb.bzl", "sonic_deb")

package(default_visibility = ["//visibility:public"])

exports_files(glob([
    "patch/*.patch",
    "libnss_tacplus_src.BUILD",
]))

VERSION = "1.0.4-1"

# =============================================================================
# libnss-tacplus — the NSS module that resolves TACACS+ users.
#
# Upstream is autotools, but nothing runs configure or make: the single
# translation unit is compiled by native cc rules and config.h is written below
# with what configure resolves to on glibc/trixie.
#
# The .so is versioned 2:0:0 because, as upstream's Makefile.am notes, the
# suffix must match the NSS module ABI version.
# =============================================================================
write_file(
    name = "config_h",
    out = "config.h",
    content = [
        "/* Bazel-generated config.h for libnss_tacplus 2.0.0 on glibc/trixie,",
        "   mirroring configure.ac's AC_CHECK_HEADERS / AC_CHECK_FUNCS results. */",
        "#define PACKAGE \"libnss_tacplus\"",
        "#define PACKAGE_NAME \"libnss_tacplus\"",
        "#define PACKAGE_VERSION \"2.0.0\"",
        "#define PACKAGE_STRING \"libnss_tacplus 2.0.0\"",
        "#define PACKAGE_TARNAME \"libnss_tacplus\"",
        "#define VERSION \"2.0.0\"",
        "#define HAVE_NSS_H 1",
        "#define HAVE_FCNTL_H 1",
        "#define HAVE_STDLIB_H 1",
        "#define HAVE_STRING_H 1",
        "#define HAVE_STRINGS_H 1",
        "#define HAVE_SYS_SOCKET_H 1",
        "#define HAVE_SYS_TIME_H 1",
        "#define HAVE_SYSLOG_H 1",
        "#define HAVE_UNISTD_H 1",
        "#define HAVE_LIBTAC_LIBTAC_H 1",
        "#define HAVE_GETHOSTBYNAME 1",
        "#define HAVE_GETTIMEOFDAY 1",
        "#define HAVE_INET_NTOA 1",
        "#define HAVE_SELECT 1",
        "#define HAVE_SOCKET 1",
        "#define HAVE_LIBTAC 1",
        "#define STDC_HEADERS 1",
    ],
)

cc_library(
    name = "config",
    hdrs = [":config_h"],
    includes = ["."],
)

sonic_shared_library_versioned(
    name = "libnss_tacplus",
    srcs = ["@libnss_tacplus_src//:nss_tacplus.c"],
    copts = [
        "-std=gnu17",
        "-D_GNU_SOURCE",
        "-DHAVE_CONFIG_H",
        "-Wno-unused-parameter",
        "-Wno-sign-compare",
    ],
    output_name = "libnss_tacplus",
    # libnss_tacplus_la_LDFLAGS = -module -version-info 2:0:0
    soversion = "2",
    version = "2.0.0",
    deps = [
        ":config",
        "@libnss_tacplus_src//:nss_tacplus_headers",
        # libnss_tacplus_la_LIBADD = -ltac
        "@pam-tacplus//:libtac",
        "@pam-tacplus//:libtac_public_headers",
    ],
)

sonic_deb(
    name = "libnss-tacplus_{}.deb".format(VERSION),
    architecture = "amd64",
    content = {
        # NSS modules live in /lib/<multiarch>.
        "/lib/x86_64-linux-gnu:*:0644": [":libnss_tacplus_files"],
        "/etc:*:0644": ["@libnss_tacplus_src//:tacplus_nss.conf"],
        "/usr/share/lintian/overrides:*:0644": [
            "@libnss_tacplus_src//:debian/libnss-tacplus.lintian-overrides",
        ],
    },
    depends = [
        "libc6 (>= 2.38)",
        "libtac2",
    ],
    description = "NSS module for TACACS+ user lookups",
    maintainer = "Sonic <sonic@microsoft.com>",
    package = "libnss-tacplus",
    priority = "optional",
    section = "admin",
    version = VERSION,
)
