load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@rules_python//python:packaging.bzl", "py_wheel")
load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@sonic_build_infra//python:pytest_test.bzl", "sonic_py_pytest_test")
load("@tar.bzl", "tar")

package(default_visibility = ["//visibility:public"])

# Pure-Python sources of sonic_yang_mgmt. setup.py declares
# py_modules=['sonic_yang', 'sonic_yang_ext', 'sonic_yang_path'].
py_library(
    name = "sources",
    srcs = [
        "sonic_yang.py",
        "sonic_yang_ext.py",
        "sonic_yang_path.py",
    ],
    imports = ["."],
    visibility = ["//visibility:public"],
)

# Test files shipped inside the wheel (Make's include_package_data=True
# captures everything under tests/, including data .json and .yang files).
py_library(
    name = "tests_pkg",
    srcs = glob([
        "tests/**/*.py",
        "tests/**/*.json",
        "tests/**/*.yang",
    ]),
    imports = ["."],
)

# Wheel's top_level.txt records top-level importable names: the three
# py_modules + the `tests` package.
genrule(
    name = "top_level_txt",
    outs = ["top_level.txt"],
    cmd = """printf 'sonic_yang\\nsonic_yang_ext\\nsonic_yang_path\\ntests\\n' > $@""",
)

# Wheel artifact (mirrors rules/sonic-yang-mgmt-py3.mk).
# install_requires from setup.py: ijson, jsonpointer, jsondiff, tabulate.
# Note: setup.py uses libyang3 (`import libyang`) and does NOT require
# xmltodict.
py_wheel(
    name = "wheel",
    distribution = "sonic_yang_mgmt",
    version = "1.0",
    summary = "Package contains Python Library for YANG for sonic.",
    author = "lnos-coders",
    author_email = "lnos-coders@linkedin.com",
    license = "GNU General Public License v3",
    python_requires = ">=2.7, !=3.0.*, !=3.1.*, !=3.2.*, !=3.3.*, !=3.4.*",
    classifiers = [
        "Development Status :: 2 - Pre-Alpha",
        "Intended Audience :: Developers",
        "License :: OSI Approved :: GNU General Public License v3 (GPLv3)",
        "Natural Language :: English",
        "Programming Language :: Python :: 2",
        "Programming Language :: Python :: 2.7",
        "Programming Language :: Python :: 3",
        "Programming Language :: Python :: 3.5",
        "Programming Language :: Python :: 3.6",
        "Programming Language :: Python :: 3.7",
        "Programming Language :: Python :: 3.8",
    ],
    requires = [
        "ijson>=3.2.3",
        "jsonpointer>=1.9",
        "jsondiff>=1.2.0",
        "tabulate==0.9.0",
    ],
    description_file = "README.rst",
    extra_distinfo_files = {
        "AUTHORS.rst": "AUTHORS.rst",
        "LICENSE": "LICENSE",
        ":top_level_txt": "top_level.txt",
    },
    data_files = {
        "sonic-cfg-help": "scripts/sonic-cfg-help",
    },
    strip_path_prefixes = ["src/sonic-yang-mgmt"],
    deps = [
        ":sources",
        ":tests_pkg",
    ],
    visibility = ["//visibility:public"],
)

# Tar layer for OCI image: lays the .py files out under Debian system Python
# dist-packages, and the sonic-cfg-help script under /usr/local/bin.
tar(
    name = "install",
    srcs = [
        "sonic_yang.py",
        "sonic_yang_ext.py",
        "sonic_yang_path.py",
        "sonic-cfg-help",
    ],
    mtree = [
        "./usr/lib/python3/dist-packages/sonic_yang.py uid=0 gid=0 mode=0644 type=file content=$(location sonic_yang.py)",
        "./usr/lib/python3/dist-packages/sonic_yang_ext.py uid=0 gid=0 mode=0644 type=file content=$(location sonic_yang_ext.py)",
        "./usr/lib/python3/dist-packages/sonic_yang_path.py uid=0 gid=0 mode=0644 type=file content=$(location sonic_yang_path.py)",
        "./usr/local/bin/sonic-cfg-help uid=0 gid=0 mode=0755 type=file content=$(location sonic-cfg-help)",
    ],
    visibility = ["//visibility:public"],
)

# =============================================================================
# Unit tests. Bazel equivalent of the Make-side test step in slave.mk's
# SONIC_PYTHON_WHEELS recipe (pip install ".[testing]" + python3 -m pytest,
# which gates the wheel).
# =============================================================================
py_library(
    name = "pytest_lib",
    testonly = True,
    srcs = glob(["tests/**/*.py"]),
    data = glob(
        ["tests/**"],
        exclude = ["tests/**/*.py"],
    ),
    imports = ["."],
    deps = [
        ":sources",
        # cffi is a runtime dep of libyang (imported by the sonic-cfg-help
        # subprocess in test_cfghelp); it lands in the venv site-packages the
        # subprocess python resolves through, alongside its _cffi_backend.so.
        "@sonic_yang_mgmt_pip//cffi",
        "@sonic_yang_mgmt_pip//ijson",
        "@sonic_yang_mgmt_pip//jsondiff",
        "@sonic_yang_mgmt_pip//jsonpointer",
        "@sonic_yang_mgmt_pip//pytest",
        "@sonic_yang_mgmt_pip//tabulate",
    ],
)

sonic_py_pytest_test(
    name = "test_sonic_yang_mgmt",
    test_file = "tests/test_sonic_yang_mgmt.py",
    # venv name from bazel/pyproject.toml [project].name.
    venv = "sonic-yang-mgmt",
    deps = [":pytest_lib"],
)

# test_cfghelp runs ../sonic-cfg-help as a subprocess. sonic-cfg-help loads
# every model in YANG_MODELS_DIR and they cross-reference sonic-types, so the
# directory must hold all 146 (142 static under yang-models/ + 4 rendered
# under gen/yang-models/). yang_models_files spans both roots, so flatten them
# into one directory here and point the script at it via the escape hatch env
# var added to sonic-cfg-help (SONIC_YANG_MODELS_DIR).
copy_to_directory(
    name = "all_yang_models_dir",
    testonly = True,
    srcs = ["@sonic-yang-models//:yang_models_files"],
    include_external_repositories = ["sonic-yang-models*"],
    # Strip both yang-models/ and gen/yang-models/ prefixes so every .yang
    # lands flat in the output root.
    replace_prefixes = {
        "gen/yang-models/": "",
        "yang-models/": "",
    },
)

# The subprocess starts fresh from the sonic-cfg-help shebang, so it inherits
# none of the in-process sys.path the pytest shim rebuilds -- it only sees what
# we hand it through the environment:
#   * PYTHONPATH: sonic_yang/* (this repo) + libyang (libyang3-py3 repo). The
#     pip deps tabulate/cffi come from the venv python the shebang resolves to.
#   * LD_LIBRARY_PATH: libyang.so.3 + its pcre2/xxhash closure, same dirs
#     sonic-yang-models enumerates (never a trixie glibc -- see that comment).
#   * SONIC_YANG_MODELS_DIR: the flattened model dir above.
# Paths are runfiles-root-relative (the test CWD is the main repo's runfiles
# dir); all three are read before the pytest shim chdirs.
_LIBYANG_LIB_DIRS = ":".join([
    "../libyang3++_repo_rules+libyang3_src",
    "../libyang3-py3+/runtime_libs",
])

_SUBPROC_PYTHONPATH = ":".join([
    "../sonic-yang-mgmt+",
    "../libyang3-py3+",
])

# The suite's class-scoped fixture reads a fixture file from a SIBLING package:
# "../sonic-yang-models/tests/files/sample_config_db.json". Make satisfies that
# because it runs from src/sonic-yang-mgmt, whose parent holds
# src/sonic-yang-models. Runfiles has no sibling of that name (dependency repos
# sit at the runfiles root as "sonic-yang-models+"), and a target may not write
# above its own package, so the sibling cannot be created there.
#
# Stage a small monorepo-shaped tree inside this package instead -- _mono/ holds
# sonic-yang-mgmt/ next to sonic-yang-models/ -- and have the pytest shim chdir
# into _mono/sonic-yang-mgmt (SONIC_TEST_CHDIR). Both "./tests/..." and
# "../sonic-yang-models/..." then resolve, with no change to the test source.
copy_to_directory(
    name = "mono_self",
    testonly = True,
    srcs = glob(["tests/**"]),
    out = "_mono/sonic-yang-mgmt/tests",
    replace_prefixes = {"tests/": ""},
)

copy_to_directory(
    name = "mono_yang_models",
    testonly = True,
    srcs = ["@sonic-yang-models//:tests_files"],
    include_external_repositories = ["sonic-yang-models*"],
    out = "_mono/sonic-yang-models/tests/files",
    replace_prefixes = {"tests/files/": ""},
)

# The suite's class-scoped autouse fixture hardcodes an absolute
# /usr/local/yang-models/ -- where Make's slave container has the
# sonic-yang-models .deb unpacked. No sandbox has that path, and
# SonicYang(dir).loadYangModel() does not raise on a missing directory, it
# silently loads zero models: only test_validate_yang_models and
# test_xlate_rev_xlate touch the real models, so just those two fail on
# `assert len(syc.jIn) == numTables` (0 == 198 -- loadData files every table of
# sample_config_db.json under tablesWithOutYang) while the other 32 cases, which
# carry their own .yang fixtures, pass. Both are green under Make.
#
# The fixture is defined inside the test class, so a conftest.py cannot override
# it (class-local fixtures shadow conftest ones), and the source tree is not ours
# to edit. Patch a COPY instead and run that. `patch` rather than `sed` on
# purpose: it carries context lines and exits non-zero when they stop matching,
# so a refactor upstream breaks the build instead of silently yielding an
# unmodified copy that would put the two cases back to `0 == 198`.
genrule(
    name = "test_sonic_yang_patched",
    testonly = True,
    srcs = [
        "tests/libyang-python-tests/test_sonic_yang.py",
        "//bazel:patches/yang_models_dir_env.patch",
    ],
    outs = ["gen/libyang-python-tests/test_sonic_yang.py"],
    # The copy comes out of the source tree read-only, hence the chmod.
    #   -F 0  no fuzz. `patch` defaults to tolerating two mismatched context
    #         lines, which would let the hunk land on drifted code and defeat
    #         the whole reason for preferring patch over sed here (verified:
    #         with the default fuzz an injected context change still applied,
    #         "succeeded at 400 with fuzz 2", and the build stayed green).
    #   -N    never apply in reverse; a stale patch must fail, not un-apply.
    #   -r    rejects to /dev/null, so a failed apply cannot leave an
    #         undeclared .rej output next to $@. The non-zero exit reports it.
    cmd = """
cp $(location tests/libyang-python-tests/test_sonic_yang.py) $@
chmod +w $@
patch -F 0 -N --no-backup-if-mismatch -r /dev/null $@ < $(location //bazel:patches/yang_models_dir_env.patch)
""",
)

# The libyang-python suite (34 of the 42 cases Make runs) opens its fixtures
# through CWD-relative paths like "./tests/libyang-python-tests/*.json", which
# is what the pytest shim's chdir into the module root already provides. It also
# needs every yang model on disk, same as test_cfghelp.
sonic_py_pytest_test(
    name = "test_sonic_yang",
    test_file = ":test_sonic_yang_patched",
    data = [
        ":all_yang_models_dir",
        ":mono_self",
        ":mono_yang_models",
    ],
    env = {
        # Run from inside the staged monorepo-shaped tree, so the fixture's
        # "../sonic-yang-models/tests/files/..." resolves (see mono_self). That
        # cwd is two levels below the package root, so the runfiles-relative
        # paths below need three "../" instead of one.
        "SONIC_TEST_CHDIR": "sonic-yang-mgmt+/_mono/sonic-yang-mgmt",
        "SONIC_YANG_MODELS_DIR": "../../../sonic-yang-mgmt+/all_yang_models_dir",
        "PYTHONPATH": ":".join([
            "../../../sonic-yang-mgmt+",
            "../../../libyang3-py3+",
        ]),
        "LD_LIBRARY_PATH": ":".join([
            "../../../libyang3++_repo_rules+libyang3_src",
            "../../../libyang3-py3+/runtime_libs",
        ]),
    },
    venv = "sonic-yang-mgmt",
    deps = [
        ":pytest_lib",
        # Imported in-process here, unlike the other two suites which only pass
        # it to a subprocess through PYTHONPATH.
        "@libyang3-py3//:libyang",
    ],
)

sonic_py_pytest_test(
    name = "test_cfghelp",
    test_file = "tests/test_cfghelp.py",
    data = [
        "sonic-cfg-help",
        ":all_yang_models_dir",
        "@libyang3-py3//:libyang",
    ],
    env = {
        "SONIC_YANG_MODELS_DIR": "../sonic-yang-mgmt+/all_yang_models_dir",
        "PYTHONPATH": _SUBPROC_PYTHONPATH,
        "LD_LIBRARY_PATH": _LIBYANG_LIB_DIRS,
    },
    venv = "sonic-yang-mgmt",
    deps = [":pytest_lib"],
)
