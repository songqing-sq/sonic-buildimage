common --registry=file://%workspace%/sonic_rules/registry
common --registry=https://raw.githubusercontent.com/aspect-build/bazel-central-registry/aspect_rules_py-v1.7.1
common --registry=https://bcr.bazel.build


common --experimental_isolated_extension_usages

common -c opt

# Keep action keys independent of the invoking client's PATH. Rules that need
# additional tools prepend their declared Bazel tool directories explicitly.
common --action_env=PATH=/usr/bin:/bin

common --platforms=@@sonic-build-infra+//platform:x86_64_trixie

common:aarch64 --platforms=@@sonic-build-infra+//platform:aarch64_trixie

build --workspace_status_command=scripts/workspace_status.sh
build --stamp
# Optional remote cache usage:
# common --remote_cache=grpc://<cache-host>:<port>
# common --experimental_remote_downloader=grpc://<cache-host>:<port>
