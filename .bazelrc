common --registry=file://%workspace%/sonic_rules/registry
common --registry=https://raw.githubusercontent.com/aspect-build/bazel-central-registry/aspect_rules_py-v1.7.1
common --registry=https://bcr.bazel.build


common --experimental_isolated_extension_usages

common -c opt

common --platforms=@@sonic-build-infra+//platform:x86_64_trixie

# Build-time tools (cfg=exec: clippy, code generators, make/tar/cpio, ...) must
# use the SAME pinned GCC + trixie sysroot as target code. Otherwise the exec
# platform stays Bazel's auto-detected host, which carries no :trixie
# constraint, //toolchains/gcc:linux_x86_64 cannot match, and Bazel silently
# falls back to /usr/bin/gcc. That mixes trixie sysroot HEADERS with the HOST
# glibc and breaks on any host older than trixie -- e.g. `undefined reference to
# __isoc23_strtoll`, a symbol that only exists from glibc 2.38.
common --extra_execution_platforms=@@sonic-build-infra+//platform:x86_64_trixie

common:aarch64 --platforms=@@sonic-build-infra+//platform:aarch64_trixie

build --workspace_status_command=scripts/workspace_status.sh
build --stamp
# === Remote Cache ===
common --remote_cache=grpc://11.159.98.184:9092
common --experimental_remote_downloader=grpc://11.159.98.184:9092

# === ### HTTPS ===
common --repo_env=https_proxy=http://11.161.18.240:3128
common --repo_env=http_proxy=http://11.161.18.240:3128
common --repo_env=GOPROXY=https://goproxy.cn,direct
