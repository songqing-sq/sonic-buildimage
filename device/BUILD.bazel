# Workspace-root package exposing the device-data tree to other Bazel packages.
#
# Bazel cannot glob across package boundaries, so sonic-device-data (and any
# other consumer that needs the per-platform data files) depends on this
# filegroup rather than trying to glob //device/... from elsewhere.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "device_tree",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

# The two inputs build_image.sh derives installer/platforms/ and
# installer/platforms_asic from (see //installer:platforms_dir). Kept as narrow
# filegroups rather than reusing :device_tree so a change to an unrelated device
# file does not invalidate the installer targets.
filegroup(
    name = "installer_confs",
    srcs = glob(
        ["*/x86_64-*/installer.conf"],
        allow_empty = False,
    ),
)

filegroup(
    name = "platform_asics",
    srcs = glob(
        ["*/*/platform_asic"],
        allow_empty = False,
    ),
)
